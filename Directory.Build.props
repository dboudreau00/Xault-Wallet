<Project>
  <!-- Shared by every project in the repo. -->
  <PropertyGroup>
    <!-- The tree builds with zero warnings; keep it that way. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Package lock files (packages.lock.json) are committed for every project. Refresh them with
         dotnet restore and the force-evaluate option after a package change. CI restores in locked
         mode, Debug and Release alike (no package depends on the configuration), so a different
         package graph than the committed one fails the build. Publishing is excluded: a
         runtime-specific restore adds runtime packs and SDK-injected packages that no single lock file
         can describe, and the release job runs the tests (a locked restore) first. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true' And '$(_IsPublishing)' != 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Release artefacts ship without symbol files (for every project in the single file). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
