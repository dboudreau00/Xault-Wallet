<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests exercise internal helpers (port ownership, stderr scrubbing, session layout).
         TestRunner compiles the unit-test sources into its own assembly, so it needs access too. -->
    <InternalsVisibleTo Include="XaultWallet.Core.Tests" />
    <InternalsVisibleTo Include="XaultWallet.IntegrationTests" />
    <InternalsVisibleTo Include="TestRunner" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id password hashing / key derivation -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- bzip2, for the official Linux/macOS Monero CLI archives (.tar.bz2) the installer unpacks -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- binaryFate's public key, unchanged from the Monero source tree (utils/gpg_keys). The
         installer trusts it only for the fingerprints pinned in MoneroSigningKeys. -->
    <EmbeddedResource Include="Installer\binaryfate.asc" LogicalName="XaultWallet.Core.Installer.binaryfate.asc" />
  </ItemGroup>

</Project>
