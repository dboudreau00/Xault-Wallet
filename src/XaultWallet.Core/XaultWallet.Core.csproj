<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests exercise internal helpers (port ownership, stderr scrubbing, session layout).
         TestRunner compiles the unit-test sources into its own assembly, so it needs access too. -->
    <InternalsVisibleTo Include="XaultWallet.Core.Tests" />
    <InternalsVisibleTo Include="XaultWallet.IntegrationTests" />
    <InternalsVisibleTo Include="TestRunner" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id password hashing / key derivation -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

</Project>
