<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XaultWallet.Desktop"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             x:Class="XaultWallet.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!-- ================= "Quiet vault" design tokens ================= -->
            <Color x:Key="AppBgColor">#141417</Color>
            <SolidColorBrush x:Key="AppBg" Color="#141417" />
            <SolidColorBrush x:Key="TitleBarBg" Color="#0F0F12" />
            <SolidColorBrush x:Key="Surface" Color="#1C1C21" />
            <SolidColorBrush x:Key="SurfaceAlt" Color="#26262D" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#30303A" />
            <SolidColorBrush x:Key="InsetBg" Color="#111114" />
            <SolidColorBrush x:Key="BorderSubtle" Color="#2A2A32" />
            <SolidColorBrush x:Key="BorderStrong" Color="#3A3A45" />
            <SolidColorBrush x:Key="TextPrimary" Color="#ECECEF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A0A0AB" />
            <SolidColorBrush x:Key="TextTertiary" Color="#6E6E7A" />
            <SolidColorBrush x:Key="AccentBrush" Color="#F76B1C" />
            <SolidColorBrush x:Key="AccentSoft" Color="#24F76B1C" />
            <SolidColorBrush x:Key="AccentText" Color="#1A1206" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#46B98A" />
            <SolidColorBrush x:Key="SuccessSoft" Color="#2246B98A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E0A030" />
            <SolidColorBrush x:Key="WarningSoft" Color="#22E0A030" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="DangerSoft" Color="#22FF6B6B" />
            <SolidColorBrush x:Key="InfoBrush" Color="#7AA7FF" />
            <SolidColorBrush x:Key="InfoSoft" Color="#227AA7FF" />
            <SolidColorBrush x:Key="Scrim" Color="#D90B0B0E" />

            <!-- Legacy keys kept as aliases -->
            <Color x:Key="XmrOrange">#F76B1C</Color>
            <SolidColorBrush x:Key="XmrOrangeBrush" Color="#F76B1C" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1C1C21" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A2A32" />

            <!-- The bundled Inter (WithInterFont) — by family name "Inter" Avalonia looks for an
                 INSTALLED font and falls back to the OS sans (DejaVu on Linux), so every platform
                 rendered differently. -->
            <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono,Cascadia Code,Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>

            <!-- Re-tint Fluent's accent (checks, radios, focus, selection) -->
            <Color x:Key="SystemAccentColor">#F76B1C</Color>
            <Color x:Key="SystemAccentColorLight1">#FF7E38</Color>
            <Color x:Key="SystemAccentColorLight2">#FF9052</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA36D</Color>
            <Color x:Key="SystemAccentColorDark1">#DD5E12</Color>
            <Color x:Key="SystemAccentColorDark2">#C1510C</Color>
            <Color x:Key="SystemAccentColorDark3">#A04407</Color>

            <!-- ================= Line icons (24×24 grid, stroked by c:Icon) ================= -->
            <StreamGeometry x:Key="IconReceive">M12 3 V14 M7.5 9.5 L12 14 L16.5 9.5 M4 15 V18 A3 3 0 0 0 7 21 H17 A3 3 0 0 0 20 18 V15</StreamGeometry>
            <StreamGeometry x:Key="IconSend">M12 14 V3 M7.5 7.5 L12 3 L16.5 7.5 M4 15 V18 A3 3 0 0 0 7 21 H17 A3 3 0 0 0 20 18 V15</StreamGeometry>
            <StreamGeometry x:Key="IconHistory">M3.5 12 A8.5 8.5 0 1 0 6 6 M3.5 3.5 V8 H8 M12 7.5 V12 L15 14</StreamGeometry>
            <StreamGeometry x:Key="IconCopy">M15.5 8.5 V6 A2.5 2.5 0 0 0 13 3.5 H6 A2.5 2.5 0 0 0 3.5 6 V13 A2.5 2.5 0 0 0 6 15.5 H8.5 M11 8.5 H18 A2.5 2.5 0 0 1 20.5 11 V18 A2.5 2.5 0 0 1 18 20.5 H11 A2.5 2.5 0 0 1 8.5 18 V11 A2.5 2.5 0 0 1 11 8.5 Z</StreamGeometry>
            <StreamGeometry x:Key="IconLock">M6.5 10.5 H17.5 A2 2 0 0 1 19.5 12.5 V19 A2 2 0 0 1 17.5 21 H6.5 A2 2 0 0 1 4.5 19 V12.5 A2 2 0 0 1 6.5 10.5 Z M8 10.5 V7.5 A4 4 0 0 1 16 7.5 V10.5 M12 14.5 V17</StreamGeometry>
            <StreamGeometry x:Key="IconRefresh">M19.5 12 A7.5 7.5 0 1 1 16.4 5.9 M19.5 3.5 V8.5 H14.5</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M4 6 H12 M16 6 H20 M12 6 A2 2 0 1 0 16 6 A2 2 0 1 0 12 6 M4 12 H6 M10 12 H20 M6 12 A2 2 0 1 0 10 12 A2 2 0 1 0 6 12 M4 18 H14 M18 18 H20 M14 18 A2 2 0 1 0 18 18 A2 2 0 1 0 14 18</StreamGeometry>
            <StreamGeometry x:Key="IconEye">M2.5 12 C5 7 8.5 5 12 5 C15.5 5 19 7 21.5 12 C19 17 15.5 19 12 19 C8.5 19 5 17 2.5 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z</StreamGeometry>
            <StreamGeometry x:Key="IconEyeOff">M2.5 12 C5 7 8.5 5 12 5 C15.5 5 19 7 21.5 12 C19 17 15.5 19 12 19 C8.5 19 5 17 2.5 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z M4 4 L20 20</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M5 12.5 L10 17.5 L19 7</StreamGeometry>
            <StreamGeometry x:Key="IconWarning">M12 4 L21.5 20 H2.5 Z M12 10 V14 M12 17 V17.2</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M12 5 V19 M5 12 H19</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M12 3.5 V15 M7.5 10.5 L12 15 L16.5 10.5 M5 20.5 H19</StreamGeometry>
            <StreamGeometry x:Key="IconShield">M12 3 L19.5 6 V11.5 C19.5 16 16.3 19.5 12 21 C7.7 19.5 4.5 16 4.5 11.5 V6 Z M9 12 L11.2 14.2 L15.5 9.8</StreamGeometry>
            <StreamGeometry x:Key="IconClock">M12 3.5 A8.5 8.5 0 1 0 12 20.5 A8.5 8.5 0 1 0 12 3.5 Z M12 7.5 V12 L15 14</StreamGeometry>
            <StreamGeometry x:Key="IconArrowDown">M12 5 V19 M6 13 L12 19 L18 13</StreamGeometry>
            <StreamGeometry x:Key="IconArrowUp">M12 19 V5 M6 11 L12 5 L18 11</StreamGeometry>
            <StreamGeometry x:Key="IconNode">M5 4 H19 A1.5 1.5 0 0 1 20.5 5.5 V9.5 A1.5 1.5 0 0 1 19 11 H5 A1.5 1.5 0 0 1 3.5 9.5 V5.5 A1.5 1.5 0 0 1 5 4 Z M5 13 H19 A1.5 1.5 0 0 1 20.5 14.5 V18.5 A1.5 1.5 0 0 1 19 20 H5 A1.5 1.5 0 0 1 3.5 18.5 V14.5 A1.5 1.5 0 0 1 5 13 Z M7.5 7.5 H7.6 M7.5 16.5 H7.6</StreamGeometry>
            <StreamGeometry x:Key="IconKey">M11.5 12 A4 4 0 1 1 3.5 12 A4 4 0 1 1 11.5 12 Z M11.5 12 H20.5 M17.5 12 V15.5 M20.5 12 V15</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M3.5 7 A2 2 0 0 1 5.5 5 H9.5 L11.5 7.5 H18.5 A2 2 0 0 1 20.5 9.5 V17 A2 2 0 0 1 18.5 19 H5.5 A2 2 0 0 1 3.5 17 Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- ================= Base ================= -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource AppBg}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="-0.2" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- :is() so SelectableTextBlock (addresses, keys) gets the mono face too. In Inter, contextual
             alternates render an "x" between digits as "×" — an address must never display differently
             from what it is. -->
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>

        <!-- ================= Surfaces ================= -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BoxShadow" Value="0 12 32 -8 #66000000" />
        </Style>
        <Style Selector="Border.inset">
            <Setter Property="Background" Value="{StaticResource InsetBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,18" />
        </Style>

        <!-- Pills (status chips) -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.pill.success"><Setter Property="Background" Value="{StaticResource SuccessSoft}" /></Style>
        <Style Selector="Border.pill.success TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></Style>
        <Style Selector="Border.pill.warning"><Setter Property="Background" Value="{StaticResource WarningSoft}" /></Style>
        <Style Selector="Border.pill.warning TextBlock"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></Style>
        <Style Selector="Border.pill.info"><Setter Property="Background" Value="{StaticResource InfoSoft}" /></Style>
        <Style Selector="Border.pill.info TextBlock"><Setter Property="Foreground" Value="{StaticResource InfoBrush}" /></Style>
        <Style Selector="Border.pill.danger"><Setter Property="Background" Value="{StaticResource DangerSoft}" /></Style>
        <Style Selector="Border.pill.danger TextBlock"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>

        <!-- Callouts (inline notices) -->
        <Style Selector="Border.callout">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource InfoSoft}" />
            <Setter Property="BorderBrush" Value="#337AA7FF" />
        </Style>
        <Style Selector="Border.callout.warning">
            <Setter Property="Background" Value="{StaticResource WarningSoft}" />
            <Setter Property="BorderBrush" Value="#44E0A030" />
        </Style>
        <Style Selector="Border.callout.danger">
            <Setter Property="Background" Value="#1FFF6B6B" />
            <Setter Property="BorderBrush" Value="#55FF6B6B" />
        </Style>
        <Style Selector="Border.callout.success">
            <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
            <Setter Property="BorderBrush" Value="#4446B98A" />
        </Style>
        <Style Selector="Border.callout TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Outcome card (a send's result): the badge and title take the outcome's colour -->
        <Style Selector="Border.outcome">
            <Setter Property="Padding" Value="14,13" />
        </Style>
        <Style Selector="Border.outcomeBadge">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.outcome TextBlock.outcomeTitle">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style Selector="Border.outcome TextBlock.outcomeDetail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="Border.outcome.success Border.outcomeBadge"><Setter Property="Background" Value="#3346B98A" /></Style>
        <Style Selector="Border.outcome.success c|Icon"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></Style>
        <Style Selector="Border.outcome.success TextBlock.outcomeTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style Selector="Border.outcome.warning Border.outcomeBadge"><Setter Property="Background" Value="#33E0A030" /></Style>
        <Style Selector="Border.outcome.warning c|Icon"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></Style>
        <Style Selector="Border.outcome.warning TextBlock.outcomeTitle"><Setter Property="Foreground" Value="#EBD9AE" /></Style>
        <Style Selector="Border.outcome.danger Border.outcomeBadge"><Setter Property="Background" Value="#33FF6B6B" /></Style>
        <Style Selector="Border.outcome.danger c|Icon"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>
        <Style Selector="Border.outcome.danger TextBlock.outcomeTitle"><Setter Property="Foreground" Value="#F3C2C2" /></Style>

        <!-- Toast (brief feedback floating over the bottom edge) -->
        <Style Selector="Border.toast">
            <Setter Property="Background" Value="#F2232329" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BoxShadow" Value="0 10 28 -6 #99000000" />
        </Style>

        <!-- ================= Buttons ================= -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InsetBg}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Primary -->
        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF7E38" />
            <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DD5E12" />
        </Style>

        <!-- Ghost (borderless, text-coloured) -->
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        </Style>

        <!-- Square icon-only -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Danger -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <!-- Window-control (caption) buttons in the custom title bar -->
        <Style Selector="Button.chrome">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
        </Style>
        <Style Selector="Button.chrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        </Style>
        <Style Selector="Button.chromeClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button.chromeClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E04434" />
        </Style>

        <!-- Inline hyperlink-style button -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF8F52" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- ================= Inputs ================= -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InsetBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InsetBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InsetBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{StaticResource InsetBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- Sync tracker / progress -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource BorderSubtle}" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="ProgressBar.synced">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </Style>

        <!-- Password strength meter -->
        <Style Selector="ProgressBar.meter">
            <Setter Property="MinHeight" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="ProgressBar.meter.fair">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>
        <Style Selector="ProgressBar.meter.strong">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </Style>

        <!-- Numbered step marker for multi-section forms -->
        <Style Selector="Border.step">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        </Style>
        <Style Selector="Border.step > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{StaticResource BorderSubtle}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- ================= Segmented tabs (wallet navigation) ================= -->
        <Style Selector="TabControl.segmented /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TabControl.segmented TabItem">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TabControl.segmented TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabControl.segmented TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TabControl.segmented TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource Surface}" />
        </Style>
        <Style Selector="TabControl.segmented TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        </Style>
        <Style Selector="TabControl.segmented TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="TabControl.segmented TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="TabControl.segmented TabItem:selected c|Icon.tabIcon">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Expander used for secondary panels -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
        </Style>

        <!-- ================= Motion: only under Window.motion (MainWindow adds it unless the user
             reduced motion; see Motion.cs). Opacity and RenderTransform only, never layout. ===== -->

        <!-- Entrances are NOT style animations here: see app:Entrance in Motion.cs. -->

        <!-- Press: buttons give a little under the pointer (not the title-bar controls or links) -->
        <Style Selector="Window.motion Button:not(.chrome):not(.link)">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window.motion Button:not(.chrome):not(.link):pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Progress moves instead of jumping (node sync, password strength) -->
        <Style Selector="Window.motion ProgressBar">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.5" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Live state: a breathing dot while syncing, a turning icon while refreshing -->
        <Style Selector="Window.motion Ellipse.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Window.motion c|Icon.spin">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="rotate(0deg)" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="rotate(360deg)" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ================= Accessible names for template parts =================
             Screen readers land on these parts, not on the control that carries the name. -->
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="AutomationProperties.Name" Value="{Binding $parent[Expander].(AutomationProperties.Name)}" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="AutomationProperties.Name" Value="Increase" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="AutomationProperties.Name" Value="Decrease" />
        </Style>
    </Application.Styles>
</Application>
