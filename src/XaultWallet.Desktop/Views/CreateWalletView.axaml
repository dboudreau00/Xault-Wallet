<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
             xmlns:app="clr-namespace:XaultWallet.Desktop"
             xmlns:conv="clr-namespace:XaultWallet.Desktop"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="714"
             x:Class="XaultWallet.Desktop.Views.CreateWalletView"
             x:DataType="vm:CreateWalletViewModel">

    <UserControl.Styles>
        <Style Selector="Border.seedWord">
            <Setter Property="Background" Value="{StaticResource InsetBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Styles>

    <!-- Root grid so the overlays can sit above the form -->
    <Grid>
        <ScrollViewer>
            <StackPanel MaxWidth="760" Margin="28,26,28,36" Spacing="16" HorizontalAlignment="Center">

                <StackPanel Spacing="6" app:Entrance.Rise="0">
                    <TextBlock Text="Create your vault" Classes="h1"/>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Your seed is sealed on this device with AES-256-GCM, its key derived from your password with Argon2id. The seed itself is generated by the official monero-wallet-rpc — never by this app."/>
                </StackPanel>

                <Border AutomationProperties.AutomationId="Create.MainnetWarning" Classes="callout danger" IsVisible="{Binding IsMainnet}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Data="{StaticResource IconWarning}" Foreground="{StaticResource DangerBrush}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Mainnet — real funds at risk" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Foreground="#F0C3C3"
                                       Text="Unaudited beta software. Mainnet transactions are irreversible. Test on stagenet or testnet first and keep an independent seed backup."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border AutomationProperties.AutomationId="Create.TestChainNotice" Classes="callout" IsVisible="{Binding IsLocalTestChain}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Data="{StaticResource IconNode}" Foreground="{StaticResource InfoBrush}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Local test chain (regtest)" FontWeight="Bold" Foreground="{StaticResource InfoBrush}"/>
                            <TextBlock Text="This node is a private chain on this computer: its coins have no value. Regtest uses mainnet-format addresses, so keep the network set to Mainnet."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 1 · Network & node ============ -->
                <Border Classes="section" app:Entrance.Rise="70">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="step"><TextBlock Text="1"/></Border>
                            <TextBlock Text="Network &amp; node" Classes="h2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,10,*">
                            <ComboBox Grid.Column="0" AutomationProperties.AutomationId="Create.Network" AutomationProperties.Name="Network" SelectedIndex="{Binding NetworkIndex}" Width="140">
                                <ComboBoxItem>Mainnet</ComboBoxItem>
                                <ComboBoxItem>Stagenet</ComboBoxItem>
                                <ComboBoxItem>Testnet</ComboBoxItem>
                            </ComboBox>
                            <TextBox Grid.Column="2" Classes="mono" FontSize="13" AutomationProperties.AutomationId="Create.Daemon" AutomationProperties.Name="Node address" Text="{Binding DaemonAddress}" Watermark="http://host:port"/>
                        </Grid>
                        <ComboBox x:CompileBindings="False" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="Create.PresetNodes" AutomationProperties.Name="Public nodes" ItemsSource="{Binding PresetNodes}" SelectedItem="{Binding SelectedPreset}"
                                  PlaceholderText="Or pick a public node…">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="Your own node is the most private. A public node's operator can see your IP address and the transactions you broadcast — never your balance or keys."/>
                    </StackPanel>
                </Border>

                <!-- ============ 2 · Recovery seed ============ -->
                <Border Classes="section" app:Entrance.Rise="140">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="step"><TextBlock Text="2"/></Border>
                            <TextBlock Text="Recovery seed" Classes="h2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="22">
                            <RadioButton GroupName="RealMode" AutomationProperties.AutomationId="Create.Mode.New" Content="Create a new wallet" IsChecked="{Binding CreateNewReal, Mode=TwoWay}"/>
                            <RadioButton GroupName="RealMode" AutomationProperties.AutomationId="Create.Mode.Import" Content="Import an existing seed"/>
                        </StackPanel>

                        <!-- Generate -->
                        <StackPanel Spacing="12" IsVisible="{Binding CreateNewReal}">
                            <Button HorizontalAlignment="Left" AutomationProperties.AutomationId="Create.GenerateSeed" AutomationProperties.Name="Generate my seed" Command="{Binding GenerateRealSeedCommand}" IsEnabled="{Binding !Busy}"
                                    IsVisible="{Binding !RealSeedGenerated}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconKey}" Width="16" Height="16"/>
                                    <TextBlock Text="Generate my seed"/>
                                </StackPanel>
                            </Button>

                            <StackPanel x:Name="SeedPanel" Spacing="12" IsVisible="{Binding RealSeedGenerated}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="WRITE THESE 25 WORDS DOWN, IN ORDER" Classes="eyebrow" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Classes="pill success" AutomationProperties.AutomationId="Create.SeedVerified" IsVisible="{Binding RealVerified}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <c:Icon Data="{StaticResource IconCheck}" Width="12" Height="12" StrokeThickness="2.4"
                                                    Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Backup verified"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ItemsControl AutomationProperties.AutomationId="Create.SeedWords" AutomationProperties.Name="Recovery seed words" ItemsSource="{Binding RealSeedWords}" x:CompileBindings="False" Margin="-4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="seedWord">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Number}" Classes="mono" FontSize="11"
                                                               Foreground="{StaticResource TextTertiary}" MinWidth="16" TextAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Word}" Classes="mono" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Classes="callout warning">
                                    <TextBlock Foreground="#EBD9AE"
                                               Text="These words ARE your wallet. Anyone who sees them can take your funds; if you lose them (and this vault), the funds are gone. Paper or steel, offline, never a screenshot."/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="accent" AutomationProperties.AutomationId="Create.OpenVerify" AutomationProperties.Name="Verify my backup" Command="{Binding OpenVerifyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:Icon Data="{StaticResource IconCheck}" Width="16" Height="16"/>
                                            <TextBlock Text="I've written them down — verify" Foreground="{StaticResource AccentText}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button AutomationProperties.AutomationId="Create.SaveBackup" AutomationProperties.Name="Save backup file" Command="{Binding DownloadRealBackupCommand}"
                                            ToolTip.Tip="Saves a PLAINTEXT file — store it offline and delete stray copies">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:Icon Data="{StaticResource IconDownload}" Width="16" Height="16"/>
                                            <TextBlock Text="Save backup file"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Import -->
                        <StackPanel Spacing="10" IsVisible="{Binding !CreateNewReal}">
                            <TextBox Classes="mono" FontSize="13" Watermark="Your 25-word seed, separated by spaces" AutomationProperties.AutomationId="Create.ImportSeed" AutomationProperties.Name="Seed to import" Text="{Binding RealMnemonic}"
                                     AcceptsReturn="True" Height="76" TextWrapping="Wrap"/>
                            <TextBox Classes="mono" FontSize="13" Watermark="Seed offset passphrase (only if you used one)" AutomationProperties.AutomationId="Create.ImportOffset" AutomationProperties.Name="Seed offset passphrase" Text="{Binding RealSeedOffset}"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                       Text="Leave the offset blank unless this seed was created WITH one elsewhere. It is case- and space-sensitive; a wrong or missing offset silently opens a different, empty wallet."/>
                            <TextBlock Text="SCAN FROM" Classes="eyebrow" Margin="0,4,0,0"/>
                            <ComboBox AutomationProperties.AutomationId="Create.RestoreMode" AutomationProperties.Name="Scan from" SelectedIndex="{Binding RestoreMode}" HorizontalAlignment="Stretch">
                                <ComboBoxItem>Full history — finds everything (safest, slowest)</ComboBoxItem>
                                <ComboBoxItem>A specific block height</ComboBoxItem>
                                <ComboBoxItem>Now — only for a brand-new seed with no history</ComboBoxItem>
                            </ComboBox>
                            <TextBox Classes="mono" Watermark="Block height, e.g. 3150000" AutomationProperties.AutomationId="Create.RestoreHeight" AutomationProperties.Name="Restore height" Text="{Binding RestoreHeightText}"
                                     IsVisible="{Binding IsSpecificHeight}" HorizontalAlignment="Left" Width="280"/>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Before anything is saved you'll see the address your seed opens, so a typo or wrong offset is caught first."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 3 · Password ============ -->
                <Border Classes="section" app:Entrance.Rise="210">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="step"><TextBlock Text="3"/></Border>
                            <TextBlock Text="Vault password" Classes="h2" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*">
                            <c:SecretTextBox Grid.Column="0" Watermark="Password" PasswordChar="●" AutomationProperties.AutomationId="Create.Password" AutomationProperties.Name="Vault password" Text="{Binding MainPassword}"/>
                            <c:SecretTextBox Grid.Column="2" Watermark="Confirm password" PasswordChar="●" AutomationProperties.AutomationId="Create.PasswordConfirm" AutomationProperties.Name="Confirm vault password" Text="{Binding MainPasswordConfirm}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,12,Auto" IsVisible="{Binding StrengthLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ProgressBar Grid.Column="0" Classes="meter" Classes.fair="{Binding StrengthIsFair}" Classes.strong="{Binding StrengthIsStrong}"
                                         Minimum="0" Maximum="5" Value="{Binding StrengthScore}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" AutomationProperties.AutomationId="Create.Strength" Text="{Binding StrengthLabel}" Classes="caption" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="A long passphrase of unrelated words is both strong and memorable. There is no recovery: forget it and only your 25 words can restore the wallet."/>
                    </StackPanel>
                </Border>

                <!-- ============ 4 · Duress (optional) ============ -->
                <Border Classes="section" app:Entrance.Rise="210">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,12,*,Auto">
                            <Border Classes="step"><TextBlock Text="4"/></Border>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Duress password" Classes="h2"/>
                                <TextBlock Classes="caption" Text="Optional · opens a separate decoy wallet that looks exactly like this one"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="3" AutomationProperties.AutomationId="Create.EnableDuress" AutomationProperties.Name="Duress password" IsChecked="{Binding EnableDuress}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="12" IsVisible="{Binding EnableDuress}">
                            <c:SecretTextBox Watermark="Duress password (different from your vault password)" PasswordChar="●" AutomationProperties.AutomationId="Create.DuressPassword" AutomationProperties.Name="Duress password" Text="{Binding DuressPassword}"/>
                            <StackPanel Orientation="Horizontal" Spacing="22">
                                <RadioButton GroupName="DuressMode" AutomationProperties.AutomationId="Create.DuressMode.Generate" Content="Generate a decoy" IsChecked="{Binding CreateNewDuress, Mode=TwoWay}"/>
                                <RadioButton GroupName="DuressMode" AutomationProperties.AutomationId="Create.DuressMode.Import" Content="Import a decoy seed"/>
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding CreateNewDuress}">
                                <Button HorizontalAlignment="Left" AutomationProperties.AutomationId="Create.GenerateDecoy" AutomationProperties.Name="Generate decoy seed" Command="{Binding GenerateDuressSeedCommand}" IsEnabled="{Binding !Busy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource IconKey}" Width="16" Height="16"/>
                                        <TextBlock Text="Generate decoy seed"/>
                                    </StackPanel>
                                </Button>
                                <Border Classes="inset" Padding="12,10" IsVisible="{Binding DuressSeedGenerated}">
                                    <SelectableTextBlock Classes="mono" FontSize="12.5" AutomationProperties.AutomationId="Create.DecoySeed" LineHeight="20" Text="{Binding DuressMnemonic}" TextWrapping="Wrap"/>
                                </Border>
                                <Button HorizontalAlignment="Left" AutomationProperties.AutomationId="Create.SaveDecoyBackup" AutomationProperties.Name="Save decoy backup" Command="{Binding DownloadDuressBackupCommand}" IsVisible="{Binding DuressSeedGenerated}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource IconDownload}" Width="16" Height="16"/>
                                        <TextBlock Text="Save decoy backup"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Spacing="8" IsVisible="{Binding !CreateNewDuress}">
                                <TextBox Classes="mono" FontSize="13" AutomationProperties.AutomationId="Create.DecoyImportSeed" AutomationProperties.Name="Decoy seed to import" Watermark="Decoy 25-word seed" Text="{Binding DuressMnemonic}"
                                         AcceptsReturn="True" Height="64" TextWrapping="Wrap"/>
                                <TextBox Classes="mono" FontSize="13" Watermark="Decoy seed offset passphrase (only if it uses one)" AutomationProperties.AutomationId="Create.DecoyImportOffset" AutomationProperties.Name="Decoy seed offset passphrase" Text="{Binding DuressSeedOffset}"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="An imported decoy always scans the full history, so any funds it holds are guaranteed to show. A decoy with a plausible small balance is more convincing than an empty one."/>
                            </StackPanel>
                            <Border Classes="callout danger" Margin="0,4,0,0">
                                <StackPanel Spacing="6">
                                    <CheckBox AutomationProperties.AutomationId="Create.WipeOnDuress" IsChecked="{Binding WipeRealOnDuress}">
                                        <TextBlock Text="Wipe the real wallet from this device when the duress password is used" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock Foreground="#F0C3C3" Margin="30,0,0,0"
                                               Text="Irreversible. Any use of the duress password — unlocking, or changing its password or node — destroys the real wallet on this device, including vault copies kept by Settings → Restore. Only enable this if your real seed is backed up elsewhere, and never use the duress password yourself."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="callout danger" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <c:Icon Data="{StaticResource IconWarning}" Foreground="{StaticResource DangerBrush}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Create.Error" Text="{Binding Error}" Foreground="#F3C2C2"/>
                    </Grid>
                </Border>

                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48"
                        AutomationProperties.AutomationId="Create.Submit" AutomationProperties.Name="Create vault" Command="{Binding CreateCommand}" IsEnabled="{Binding !Busy}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <c:Icon Data="{StaticResource IconShield}" Width="17" Height="17"/>
                        <TextBlock Text="Create vault" FontSize="15" Foreground="{StaticResource AccentText}"/>
                    </StackPanel>
                </Button>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Verification overlay ===== -->
        <Border x:Name="VerifyScrim" IsVisible="{Binding ShowVerifyOverlay}" Background="{StaticResource Scrim}">
            <Border x:Name="VerifySheet" Classes="card" Width="460" Padding="28,26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Check your backup" Classes="h2"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Type the words at these positions from what you wrote down — not from the screen."/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock AutomationProperties.AutomationId="Verify.Prompt1" Text="{Binding VerifyPrompt1}" Classes="eyebrow"/>
                        <TextBox Classes="mono" AutomationProperties.AutomationId="Verify.Input1" AutomationProperties.Name="First word" Text="{Binding VerifyInput1}"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock AutomationProperties.AutomationId="Verify.Prompt2" Text="{Binding VerifyPrompt2}" Classes="eyebrow"/>
                        <TextBox Classes="mono" AutomationProperties.AutomationId="Verify.Input2" AutomationProperties.Name="Second word" Text="{Binding VerifyInput2}"/>
                    </StackPanel>
                    <StackPanel Spacing="5">
                        <TextBlock AutomationProperties.AutomationId="Verify.Prompt3" Text="{Binding VerifyPrompt3}" Classes="eyebrow"/>
                        <TextBox Classes="mono" AutomationProperties.AutomationId="Verify.Input3" AutomationProperties.Name="Third word" Text="{Binding VerifyInput3}"/>
                    </StackPanel>

                    <TextBlock AutomationProperties.AutomationId="Verify.Message" Text="{Binding VerifyMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12.5" TextWrapping="Wrap"
                               IsVisible="{Binding VerifyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Grid ColumnDefinitions="*,10,*">
                        <Button Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="Verify.Cancel" Command="{Binding CloseVerifyCommand}"/>
                        <Button Grid.Column="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="Verify.Submit" AutomationProperties.Name="Verify" Command="{Binding VerifyRealSeedCommand}">
                            <TextBlock Text="Verify" Foreground="{StaticResource AccentText}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== Imported-seed address confirmation (hard stop before sealing) ===== -->
        <Border x:Name="AddressScrim" IsVisible="{Binding ShowAddressConfirm}" Background="{StaticResource Scrim}">
            <Border x:Name="AddressSheet" Classes="card" Width="560" Padding="28,26" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Is this your wallet?" Classes="h2"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="This is the address your imported seed opens. Compare it with the wallet you meant to import. A wrong seed or offset opens a valid but DIFFERENT, empty wallet — the app can't tell the difference, only you can."/>
                    </StackPanel>

                    <Border Classes="inset" Padding="14,12" IsVisible="{Binding HasConfirmRealAddress}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="PRIMARY ADDRESS" Classes="eyebrow"/>
                            <SelectableTextBlock AutomationProperties.AutomationId="Confirm.RealAddress" Text="{Binding ConfirmRealAddress}" Classes="mono" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="inset" Padding="14,12" IsVisible="{Binding HasConfirmDuressAddress}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="DECOY WALLET ADDRESS" Classes="eyebrow"/>
                            <SelectableTextBlock AutomationProperties.AutomationId="Confirm.DecoyAddress" Text="{Binding ConfirmDuressAddress}" Classes="mono" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,10,*">
                        <Button Content="No — go back" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="Confirm.No" Command="{Binding CancelAddressConfirmCommand}"/>
                        <Button Grid.Column="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.AutomationId="Confirm.Yes" AutomationProperties.Name="Yes, create vault" Command="{Binding ConfirmAddressesCommand}">
                            <TextBlock Text="Yes — create vault" Foreground="{StaticResource AccentText}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
