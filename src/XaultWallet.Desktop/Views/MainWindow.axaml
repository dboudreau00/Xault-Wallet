<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
        xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
        xmlns:app="clr-namespace:XaultWallet.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="660"
        x:Class="XaultWallet.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="XaultWallet" Width="1080" Height="760"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/xault.ico"
        Background="{StaticResource AppBg}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Custom title bar: our own chrome extended to the top edge. The TitleBar role gives it the
             system's own dragging, double-click to maximise and snapping. Every button on it carries the
             User role: without one, the system takes a click on the button for a click on the bar. -->
        <Border Grid.Row="0" Background="{StaticResource TitleBarBg}" BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1" WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="46">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                    <Canvas Width="20" Height="20" VerticalAlignment="Center">
                        <Line StartPoint="4,3.5" EndPoint="16,16.5" Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="3" StrokeLineCap="Round"/>
                        <Line StartPoint="16,3.5" EndPoint="4,16.5" Stroke="{StaticResource TextPrimary}"
                              StrokeThickness="3" StrokeLineCap="Round"/>
                    </Canvas>
                    <TextBlock Text="Xault" FontSize="16.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Wallet" FontSize="16.5" FontWeight="Light" VerticalAlignment="Center"
                               Margin="-6,0,0,0" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="ghost" AutomationProperties.AutomationId="Shell.Settings" AutomationProperties.Name="Settings" Command="{Binding OpenSettingsCommand}"
                        WindowDecorationProperties.ElementRole="User"
                        IsVisible="{Binding !SettingsOpen}" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,10,0" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Data="{StaticResource IconSettings}" Width="16" Height="16"/>
                        <TextBlock Text="Settings" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Window controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Classes="chrome" AutomationProperties.AutomationId="Shell.Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click" ToolTip.Tip="Minimize"
                            WindowDecorationProperties.ElementRole="User">
                        <Rectangle Width="11" Height="1.5" Fill="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="chrome" AutomationProperties.AutomationId="Shell.Maximize" AutomationProperties.Name="Maximize" Click="MaxRestore_Click" ToolTip.Tip="Maximize"
                            WindowDecorationProperties.ElementRole="User">
                        <Border Width="10" Height="10" BorderBrush="{StaticResource TextSecondary}" BorderThickness="1.5" CornerRadius="2"/>
                    </Button>
                    <Button Classes="chrome chromeClose" AutomationProperties.AutomationId="Shell.Close" AutomationProperties.Name="Close" Click="Close_Click" ToolTip.Tip="Close"
                            WindowDecorationProperties.ElementRole="User">
                        <Canvas Width="12" Height="12">
                            <Line StartPoint="1,1" EndPoint="11,11" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"/>
                            <Line StartPoint="11,1" EndPoint="1,11" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"/>
                        </Canvas>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Across every screen: Enhanced Security asking to be kept on, and what the app noticed
             about its own setup (a browser connection changed behind its back...). -->
        <StackPanel Grid.Row="1">
            <Border Classes="callout" Margin="18,10,18,0" Padding="14,10" IsVisible="{Binding ConfirmingEnhancedSecurity}"
                    AutomationProperties.AutomationId="Shell.EnhancedConfirm">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconShield}" Width="16" Height="16" Margin="0,0,10,0"
                            Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding EnhancedSecurityCountdown}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"/>
                    <Button Grid.Column="2" Classes="accent" Margin="12,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.KeepEnhanced" AutomationProperties.Name="Keep Enhanced Security on"
                            Command="{Binding KeepEnhancedSecurityCommand}">
                        <TextBlock Text="Keep it on" Foreground="{StaticResource AccentText}"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="callout" Margin="18,10,18,0" Padding="14,10" IsVisible="{Binding HasPairAsk}"
                    AutomationProperties.AutomationId="Shell.PairAsk">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconLink}" Width="16" Height="16" Margin="0,0,10,0"
                            Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Shell.PairAskText" Text="{Binding PairAskNote}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="12.5"/>
                    <Button Grid.Column="2" Content="Allow" Margin="12,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.AllowExtension" AutomationProperties.Name="Allow the browser extension" Command="{Binding AllowExtensionCommand}"
                            IsEnabled="{Binding !PairAskHeld}" Focusable="False" IsTabStop="False"/>
                    <Button Grid.Column="3" Content="Deny" Margin="6,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.DenyExtension" AutomationProperties.Name="Refuse the browser extension" Command="{Binding DenyExtensionCommand}"/>
                </Grid>
            </Border>
            <Border Classes="callout" Margin="18,10,18,0" Padding="14,10" IsVisible="{Binding HasReceiveAsk}"
                    AutomationProperties.AutomationId="Shell.ReceiveAsk">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconLink}" Width="16" Height="16" Margin="0,0,10,0"
                            Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Shell.ReceiveAskText" Text="{Binding ReceiveAskNote}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="12.5"/>
                    <Button Grid.Column="2" Content="Give address" Margin="12,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.AllowReceive" AutomationProperties.Name="Give the browser a new address" Command="{Binding AllowReceiveRequestCommand}"
                            IsEnabled="{Binding !ReceiveAskHeld}" Focusable="False" IsTabStop="False"/>
                    <Button Grid.Column="3" Classes="ghost icon" Margin="6,0,-4,0" Padding="6" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.DismissReceive" AutomationProperties.Name="Refuse the browser's address request" ToolTip.Tip="Refuse"
                            Command="{Binding DismissReceiveRequestCommand}">
                        <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="callout" Margin="18,10,18,0" Padding="14,10" IsVisible="{Binding HasHeldRequest}"
                    AutomationProperties.AutomationId="Shell.HeldRequest">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconLink}" Width="16" Height="16" Margin="0,0,10,0"
                            Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Shell.HeldRequestText" Text="{Binding HeldRequestNote}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="12.5"/>
                    <Button Grid.Column="2" Content="Open it" Margin="12,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.OpenHeldRequest" AutomationProperties.Name="Open the payment request" Command="{Binding OpenHeldRequestCommand}"/>
                    <Button Grid.Column="3" Classes="ghost icon" Margin="6,0,-4,0" Padding="6" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.DismissHeldRequest" AutomationProperties.Name="Dismiss the payment request" ToolTip.Tip="Dismiss"
                            Command="{Binding DismissHeldRequestCommand}">
                        <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>
            <Border Classes="callout" Classes.warning="{Binding NoticeIsWarning}" Margin="18,10,18,0" Padding="14,10"
                    IsVisible="{Binding HasNotice}" AutomationProperties.AutomationId="Shell.Notice">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconWarning}" Width="16" Height="16" Margin="0,0,10,0"
                            Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" IsVisible="{Binding NoticeIsWarning}"/>
                    <c:Icon Grid.Column="0" Data="{StaticResource IconShield}" Width="16" Height="16" Margin="0,0,10,0"
                            Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !NoticeIsWarning}"/>
                    <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Shell.NoticeText" Text="{Binding Notice}" TextWrapping="Wrap"
                               VerticalAlignment="Center" FontSize="12.5"/>
                    <Button Grid.Column="2" Content="Review" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding NoticeOffersSettings}"
                            AutomationProperties.AutomationId="Shell.ReviewNotice" AutomationProperties.Name="Review in Settings" Command="{Binding ReviewNoticeCommand}"/>
                    <Button Grid.Column="3" Classes="ghost icon" Margin="6,0,-4,0" Padding="6" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell.DismissNotice" AutomationProperties.Name="Dismiss" ToolTip.Tip="Dismiss"
                            Command="{Binding DismissNoticeCommand}">
                        <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Screen changes: the old screen fades out, the new one rises into place (instant with
             reduced motion; see Motion). -->
        <TransitioningContentControl Grid.Row="2" Content="{Binding Current}" Margin="0">
            <TransitioningContentControl.PageTransition>
                <app:FadeLiftTransition/>
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Grid>
</Window>
