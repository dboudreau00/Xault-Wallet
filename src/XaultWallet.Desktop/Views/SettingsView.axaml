<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
             xmlns:app="clr-namespace:XaultWallet.Desktop"
             xmlns:conv="clr-namespace:XaultWallet.Desktop"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             xmlns:v="clr-namespace:XaultWallet.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="714"
             x:Class="XaultWallet.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.sectionIcon">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        </Style>
        <Style Selector="Border.sectionIcon > c|Icon">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.result">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Sticky header -->
        <Border Grid.Row="0" Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="820" Margin="28,18" ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Settings" Classes="h1"/>
                    <TextBlock Classes="caption" Text="Stored in settings.json beside your vault — no secrets are ever written there."/>
                </StackPanel>
                <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Settings.SavedMessage" Text="{Binding SavedMessage}" Classes="caption" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{StaticResource SuccessBrush}" MaxWidth="260" TextWrapping="Wrap"/>
                <Button Grid.Column="2" Classes="accent" AutomationProperties.AutomationId="Settings.Save" AutomationProperties.Name="Save changes" Command="{Binding SaveCommand}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="Save changes" Foreground="{StaticResource AccentText}"/>
                </Button>
                <Button Grid.Column="3" AutomationProperties.AutomationId="Settings.Close" AutomationProperties.Name="Close settings" Command="{Binding CloseCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                        <TextBlock Text="Close"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="820" Margin="28,20,28,36" Spacing="14">

                <!-- ============ Wallet backend ============ -->
                <Border Classes="section" app:Entrance.Rise="70">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="sectionIcon"><c:Icon Data="{StaticResource IconKey}"/></Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Wallet backend" Classes="h2"/>
                                <TextBlock Classes="caption" Text="The official monero-wallet-rpc. XaultWallet never reimplements Monero's cryptography."/>
                            </StackPanel>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                            <TextBox Grid.Column="0" Classes="mono" FontSize="12.5"
                                     PlaceholderText="Path to monero-wallet-rpc (blank = auto-detect)" AutomationProperties.AutomationId="Settings.BinaryPath" AutomationProperties.Name="Path to monero-wallet-rpc" Text="{Binding WalletRpcBinaryPath}"/>
                            <Button Grid.Column="2" Content="Browse…" AutomationProperties.AutomationId="Settings.Browse" Command="{Binding BrowseCommand}"/>
                            <Button Grid.Column="4" Content="Test" AutomationProperties.AutomationId="Settings.TestBinary" AutomationProperties.Name="Test monero-wallet-rpc" Command="{Binding TestBinaryCommand}" IsEnabled="{Binding !Busy}"/>
                        </Grid>
                        <TextBlock Text="{Binding DefaultBinaryHint}" Classes="caption mono" TextWrapping="Wrap"/>
                        <TextBlock AutomationProperties.AutomationId="Settings.BinaryTestResult" Text="{Binding BinaryTestResult}" Classes="result"
                                   IsVisible="{Binding BinaryTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding BinaryTestOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                        <Separator Margin="0,2"/>
                        <TextBlock Text="DON'T HAVE IT YET?" Classes="eyebrow"/>
                        <v:WalletRpcSetupPanel DataContext="{Binding Setup}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Network & privacy ============ -->
                <Border Classes="section" app:Entrance.Rise="140">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="sectionIcon"><c:Icon Data="{StaticResource IconNode}"/></Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Network &amp; privacy" Classes="h2"/>
                                <TextBlock Classes="caption" Text="Defaults for new wallets, and how the backend reaches its node."/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="DEFAULT NODE FOR NEW WALLETS" Classes="eyebrow"/>
                        <Grid ColumnDefinitions="Auto,10,*,8,Auto">
                            <ComboBox Grid.Column="0" AutomationProperties.AutomationId="Settings.Network" AutomationProperties.Name="Default network" SelectedIndex="{Binding NetworkIndex}" Width="140">
                                <ComboBoxItem>Mainnet</ComboBoxItem>
                                <ComboBoxItem>Stagenet</ComboBoxItem>
                                <ComboBoxItem>Testnet</ComboBoxItem>
                            </ComboBox>
                            <TextBox Grid.Column="2" Classes="mono" FontSize="12.5" PlaceholderText="http://host:port" AutomationProperties.AutomationId="Settings.DefaultDaemon" AutomationProperties.Name="Default node address" Text="{Binding DefaultDaemonAddress}"/>
                            <Button Grid.Column="4" Content="Test" AutomationProperties.AutomationId="Settings.TestDaemon" AutomationProperties.Name="Test node" Command="{Binding TestDaemonCommand}" IsEnabled="{Binding !Busy}"/>
                        </Grid>
                        <ComboBox x:CompileBindings="False" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="Settings.PresetNodes" AutomationProperties.Name="Public nodes"
                                  ItemsSource="{Binding PresetNodes}" SelectedItem="{Binding SelectedPreset}"
                                  PlaceholderText="Or pick a public node…">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock AutomationProperties.AutomationId="Settings.DaemonTestResult" Text="{Binding DaemonTestResult}" Classes="result"
                                   IsVisible="{Binding DaemonTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding DaemonTestOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>

                        <TextBlock Text="HOW XAULTWALLET REACHES THE NETWORK" Classes="eyebrow" Margin="0,6,0,0"/>
                        <StackPanel Spacing="6">
                            <RadioButton GroupName="NetworkMode" AutomationProperties.AutomationId="Settings.ModeTor" AutomationProperties.Name="Built-in Tor"
                                         IsChecked="{Binding NetworkMode, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=1}">
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <c:Icon Data="{StaticResource IconOnion}" Width="15" Height="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tor, built in (recommended)" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="XaultWallet runs its own Tor. Nodes never see your IP address, and nothing goes out directly while Tor connects. A node on this computer is reached directly."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NetworkMode" AutomationProperties.AutomationId="Settings.ModeProxy" AutomationProperties.Name="My own SOCKS proxy"
                                         IsChecked="{Binding NetworkMode, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=2}">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="My own SOCKS proxy" FontWeight="SemiBold"/>
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="A Tor you already run (Tor Browser listens on 127.0.0.1:9150), or another SOCKS proxy."/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NetworkMode" AutomationProperties.AutomationId="Settings.ModeDirect" AutomationProperties.Name="Direct"
                                         IsChecked="{Binding NetworkMode, Converter={x:Static conv:IntEqualsConverter.Instance}, ConverterParameter=0}">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="Direct" FontWeight="SemiBold"/>
                                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="The node sees your IP address."/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Grid ColumnDefinitions="260,12,*" IsVisible="{Binding ProxySelected}">
                            <TextBox Grid.Column="0" Classes="mono" FontSize="12.5" PlaceholderText="127.0.0.1:9050" AutomationProperties.AutomationId="Settings.Proxy" AutomationProperties.Name="SOCKS proxy" Text="{Binding ProxyAddress}"/>
                            <TextBlock Grid.Column="2" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="host:port. Node traffic and the in-app downloads go through it."/>
                        </Grid>

                        <!-- Built-in Tor: status, start/stop, which tor, install -->
                        <Border Classes="inset" Padding="16,14" IsVisible="{Binding TorSelected}" AutomationProperties.AutomationId="Settings.TorPanel">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"
                                             Classes.pulse="{Binding Tor.IsStarting}"
                                             Fill="{Binding Tor.IsReady, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="Settings.TorStatus" Text="{Binding Tor.StatusText}"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                                        <Button AutomationProperties.AutomationId="Settings.RestartTor" AutomationProperties.Name="Start or restart Tor"
                                                Command="{Binding RestartTorCommand}" IsEnabled="{Binding !Tor.IsStarting}"
                                                ToolTip.Tip="Start Tor with the saved settings, or restart it">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <c:Icon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                                                <TextBlock Text="Start / restart"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Stop" AutomationProperties.AutomationId="Settings.StopTor" AutomationProperties.Name="Stop Tor"
                                                Command="{Binding StopTorCommand}"
                                                ToolTip.Tip="Stop Tor. While Tor is chosen, wallets wait for it rather than connect directly."/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Tor.Percent}" IsVisible="{Binding Tor.IsStarting}"/>
                                <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                                    <TextBox Grid.Column="0" Classes="mono" FontSize="12.5" PlaceholderText="Path to tor (blank = the one XaultWallet installed)"
                                             AutomationProperties.AutomationId="Settings.TorPath" AutomationProperties.Name="Path to tor" Text="{Binding TorBinaryPath}"/>
                                    <Button Grid.Column="2" Content="Browse…" AutomationProperties.AutomationId="Settings.BrowseTor" AutomationProperties.Name="Browse for tor" Command="{Binding BrowseTorCommand}"/>
                                    <Button Grid.Column="4" Content="Test" AutomationProperties.AutomationId="Settings.TestTor" AutomationProperties.Name="Test tor" Command="{Binding TestTorCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding TorBinaryHint}" Classes="caption mono" TextWrapping="Wrap"/>
                                <TextBlock AutomationProperties.AutomationId="Settings.TorTestResult" Text="{Binding TorTestResult}" Classes="result"
                                           IsVisible="{Binding TorTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{Binding TorTestOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                                <Separator Margin="0,2"/>
                                <v:TorSetupPanel DataContext="{Binding TorSetup}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="A wallet that is already open keeps its route until it is opened again (lock and unlock, or Retry)."/>
                    </StackPanel>
                </Border>

                <!-- ============ Security ============ -->
                <Border Classes="section" app:Entrance.Rise="210">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="sectionIcon"><c:Icon Data="{StaticResource IconLock}"/></Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Security" Classes="h2"/>
                                <TextBlock Classes="caption" Text="Locking shuts the backend down and shreds the wallet's temporary files."/>
                            </StackPanel>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="AUTO-LOCK AFTER" Classes="eyebrow"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown AutomationProperties.AutomationId="Settings.AutoLock" AutomationProperties.Name="Auto-lock after minutes" Value="{Binding AutoLockMinutes}" Minimum="0" Maximum="240" Increment="1"
                                                   FormatString="0" Width="130"/>
                                    <TextBlock Text="minutes idle (0 = never)" Classes="muted" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="REFRESH EVERY" Classes="eyebrow"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <NumericUpDown AutomationProperties.AutomationId="Settings.AutoRefresh" AutomationProperties.Name="Refresh every seconds" Value="{Binding AutoRefreshSeconds}" Minimum="5" Maximum="600" Increment="5"
                                                   FormatString="0" Width="130"/>
                                    <TextBlock Text="seconds" Classes="muted" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ This wallet (only with a vault) ============ -->
                <Border Classes="section" app:Entrance.Rise="210" IsVisible="{Binding VaultExists}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="sectionIcon"><c:Icon Data="{StaticResource IconShield}"/></Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Vault password" Classes="h2"/>
                                <TextBlock Classes="caption" Text="Changes the password of the wallets it opens. Your seeds never change."/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Text="A wallet's node, name and keys are in the wallet itself: Manage wallet, next to its name."/>

                        <TextBlock Text="CHANGE PASSWORD" Classes="eyebrow"/>
                        <c:SecretTextBox PlaceholderText="Current password" PasswordChar="●" AutomationProperties.AutomationId="Settings.CurrentPassword" AutomationProperties.Name="Current password" Text="{Binding CurrentPassword}"/>
                        <Grid ColumnDefinitions="*,12,*">
                            <c:SecretTextBox Grid.Column="0" PlaceholderText="New password" PasswordChar="●" AutomationProperties.AutomationId="Settings.NewPassword" AutomationProperties.Name="New password" Text="{Binding NewPassword}"/>
                            <c:SecretTextBox Grid.Column="2" PlaceholderText="Confirm new password" PasswordChar="●" AutomationProperties.AutomationId="Settings.NewPasswordConfirm" AutomationProperties.Name="Confirm new password" Text="{Binding NewPasswordConfirm}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding NewPasswordStrength}" Classes="caption" VerticalAlignment="Center"
                                       IsVisible="{Binding NewPasswordStrength, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Button Grid.Column="1" Content="Change password" AutomationProperties.AutomationId="Settings.ChangePassword" Command="{Binding ChangePasswordCommand}" IsEnabled="{Binding !Busy}"/>
                        </Grid>
                        <TextBlock AutomationProperties.AutomationId="Settings.ChangePasswordResult" Text="{Binding ChangePasswordResult}" Classes="result"
                                   IsVisible="{Binding ChangePasswordResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding ChangePasswordOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Vault format (a vault from 0.1–0.3; same words for either password) ============ -->
                <Border Classes="section" app:Entrance.Rise="210" IsVisible="{Binding ShowFormatCard}" AutomationProperties.AutomationId="Settings.FormatCard">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="sectionIcon"><c:Icon Data="{StaticResource IconRefresh}"/></Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Vault format" Classes="h2"/>
                                <TextBlock Classes="caption" Text="This vault was made by XaultWallet 0.3 or earlier."/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="It keeps that format until you upgrade it: about 4 KB for the wallets, contacts and notes of each password. Upgrading makes room for many more (256 KB per password); 0.3 can't open the vault afterwards. It can't be undone: export a backup first if you might go back to 0.3."/>
                        <Border Classes="callout warning">
                            <TextBlock Foreground="#EBD9AE" TextWrapping="Wrap"
                                       Text="Upgrading converts only the part of the vault that the password you unlocked with opens. If this vault has a second password, its part stays in the old format until that password is used in 0.5 — and until then, anyone holding it and the vault file can tell that another password was used. So upgrade from the second password first. If that password is set to wipe the other wallets when used, don't use it: rebuild the vault instead (SECURITY.md, “Upgrading to 0.5”)."/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding VaultIsOldFormat}">
                            <Button Content="Upgrade vault…" AutomationProperties.AutomationId="Settings.AskUpgradeFormat" Command="{Binding AskFormatUpgradeCommand}"
                                    IsVisible="{Binding !ConfirmFormatUpgrade}"/>
                            <Button Classes="accent" AutomationProperties.AutomationId="Settings.UpgradeFormat" AutomationProperties.Name="Upgrade now"
                                    Command="{Binding UpgradeFormatCommand}" IsVisible="{Binding ConfirmFormatUpgrade}" IsEnabled="{Binding !Busy}">
                                <TextBlock Text="Upgrade now" Foreground="{StaticResource AccentText}"/>
                            </Button>
                            <Button Content="Cancel" AutomationProperties.AutomationId="Settings.CancelUpgradeFormat" Command="{Binding CancelFormatUpgradeCommand}"
                                    IsVisible="{Binding ConfirmFormatUpgrade}"/>
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Settings.FormatUpgradeResult" Text="{Binding FormatUpgradeResult}" Classes="result" TextWrapping="Wrap"
                                   IsVisible="{Binding FormatUpgradeResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding FormatUpgradeOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Backup ============ -->
                <Border Classes="section" app:Entrance.Rise="210">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="sectionIcon"><c:Icon Data="{StaticResource IconDownload}"/></Border>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Encrypted vault backup" Classes="h2"/>
                                <TextBlock Classes="caption" Text="A copy of vault.xv — still protected by your password(s)."/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Restoring brings a lost or corrupted vault back. A backup made before a duress wipe still contains the wiped wallet — keep it somewhere a coercer can't find. Restore is only offered while no wallet is unlocked; the replaced vault is kept beside the new one (a duress wipe destroys those kept copies too)."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Settings.ExportVault" AutomationProperties.Name="Export backup" Command="{Binding ExportVaultCommand}" IsEnabled="{Binding VaultExists}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconDownload}" Width="16" Height="16"/>
                                    <TextBlock Text="Export backup…"/>
                                </StackPanel>
                            </Button>
                            <Button AutomationProperties.AutomationId="Settings.RestoreVault" AutomationProperties.Name="Restore from backup" Command="{Binding RestoreVaultCommand}" IsEnabled="{Binding CanRestoreVault}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
                                    <TextBlock Text="Restore from backup…"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock AutomationProperties.AutomationId="Settings.BackupResult" Text="{Binding BackupResult}" Classes="result"
                                   IsVisible="{Binding BackupResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{Binding BackupOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                    </StackPanel>
                </Border>

                <!-- ============ Folders & about ============ -->
                <Border Classes="section" app:Entrance.Rise="210">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <c:NamedTextBlock Classes="h2" AutomationProperties.AutomationId="Settings.AppVersion">
                                <Run Text="XaultWallet"/><Run Text="  " FontSize="12"/><Run Text="{Binding AppVersion}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource TextTertiary}"/>
                            </c:NamedTextBlock>
                            <TextBlock Classes="caption" Text="Unaudited beta · MIT licensed · brought to life in harmony"/>
                            <Button Classes="link" Content="dboudreau.dev" Click="OpenLink_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="ghost" AutomationProperties.AutomationId="Settings.DataFolder" AutomationProperties.Name="Open data folder" Command="{Binding OpenDataFolderCommand}" ToolTip.Tip="vault.xv and settings.json">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconFolder}" Width="16" Height="16"/>
                                    <TextBlock Text="Data folder"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="ghost" AutomationProperties.AutomationId="Settings.LogsFolder" AutomationProperties.Name="Open logs folder" Command="{Binding OpenLogsFolderCommand}" ToolTip.Tip="Diagnostic logs — no secrets are ever logged">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconFolder}" Width="16" Height="16"/>
                                    <TextBlock Text="Logs"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
