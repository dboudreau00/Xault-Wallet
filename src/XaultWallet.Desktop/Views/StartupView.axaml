<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             xmlns:app="clr-namespace:XaultWallet.Desktop"
             xmlns:v="clr-namespace:XaultWallet.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="XaultWallet.Desktop.Views.StartupView"
             x:DataType="vm:StartupViewModel">

    <!-- The glow pulses (a looping style animation: nothing is committed when it stops). The mark
         and text fade in staggered through app:Entrance (see Motion.cs for why not styles). -->
    <UserControl.Styles>
        <Style Selector="Ellipse.glowPulse">
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.42"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.12"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.42"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Spacing="28" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,24">

            <!-- X badge with an ambient glow (glow pulses; the mark fades in) -->
            <Grid Width="150" Height="150" HorizontalAlignment="Center">
                <Ellipse Classes="glowPulse" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource AccentBrush}"/>

                <Border app:Entrance.Fade="0" Width="86" Height="86" CornerRadius="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}"
                        BorderThickness="1" BoxShadow="0 16 44 -8 #77000000">
                    <Grid>
                        <Canvas Width="86" Height="86">
                            <Line StartPoint="27,25" EndPoint="59,61" Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="8.5" StrokeLineCap="Round"/>
                            <Line StartPoint="59,25" EndPoint="27,61" Stroke="{StaticResource TextPrimary}"
                                  StrokeThickness="8.5" StrokeLineCap="Round"/>
                        </Canvas>
                        <Ellipse app:Entrance.Fade="350" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{StaticResource Surface}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel app:Entrance.Fade="300" Spacing="5">
                <c:NamedTextBlock HorizontalAlignment="Center" AutomationProperties.Name="XaultWallet">
                    <Run Text="Xault" FontSize="24" FontWeight="Bold"/><Run Text="Wallet" FontSize="24" FontWeight="Light" Foreground="{StaticResource TextSecondary}"/>
                </c:NamedTextBlock>
                <TextBlock AutomationProperties.AutomationId="Startup.Status" Text="{Binding Status}" Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel app:Entrance.Fade="550" Spacing="14">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Checking}" Height="3" Width="220"
                             HorizontalAlignment="Center"/>
                <TextBlock AutomationProperties.AutomationId="Startup.Detail" Text="{Binding Detail}" Classes="eyebrow" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                <Button Content="Continue anyway" AutomationProperties.AutomationId="Startup.Continue" Command="{Binding ContinueCommand}"
                        IsVisible="{Binding ShowContinue}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- No monero-wallet-rpc yet: set it up here instead of failing later. -->
            <Border Classes="card" IsVisible="{Binding NeedsBackend}" Width="540" Padding="26,22" HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="Startup.BackendSetup" app:Entrance.Rise="0">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Every wallet runs on Monero's own wallet program" Classes="h2"/>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="XaultWallet hands your keys to monero-wallet-rpc, the official program from the Monero project. It wasn't found next to the app, on PATH, or in Settings."/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Command="{Binding ChooseOwnCopyCommand}"
                            AutomationProperties.AutomationId="Startup.ChooseOwn" AutomationProperties.Name="Choose my own monero-wallet-rpc">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <c:Icon Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                            <TextBlock Text="I have it: choose my copy…"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="caption" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               Text="{Binding ChooseResult}" IsVisible="{Binding ChooseResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               AutomationProperties.AutomationId="Startup.ChooseResult"/>
                    <Separator/>
                    <v:WalletRpcSetupPanel DataContext="{Binding Setup}"/>
                    <Button Classes="link" HorizontalAlignment="Left" Command="{Binding ContinueCommand}"
                            AutomationProperties.AutomationId="Startup.SkipBackend" AutomationProperties.Name="Continue without it">
                        <TextBlock Text="Continue without it (set it later in Settings)"/>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
