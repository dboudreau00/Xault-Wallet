<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             xmlns:w="clr-namespace:XaultWallet.Desktop.Views.Wallet"
             x:Class="XaultWallet.Desktop.Views.Wallet.ContactsTab"
             x:DataType="vm:WalletViewModel">
    <ScrollViewer Margin="0,14,0,0">
        <StackPanel Spacing="14">
            <!-- Add / edit a contact -->
            <Border x:Name="Editor" Classes="card" Padding="22,20" IsVisible="{Binding ContactEditorOpen}" AutomationProperties.AutomationId="Contacts.Editor">
                <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Classes="h2" Text="{Binding ContactEditorTitle}"/>
                    <Grid ColumnDefinitions="240,12,*">
                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Text="NAME" Classes="eyebrow"/>
                            <TextBox MaxLength="60" Watermark="Who is it?" AutomationProperties.AutomationId="Contacts.Name" AutomationProperties.Name="Contact name"
                                     Text="{Binding ContactName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Text="NOTE (OPTIONAL)" Classes="eyebrow"/>
                            <TextBox MaxLength="200" Watermark="e.g. rent, the shop's donation address" AutomationProperties.AutomationId="Contacts.Note"
                                     AutomationProperties.Name="Contact note" Text="{Binding ContactNote}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="7">
                        <TextBlock Text="ADDRESS" Classes="eyebrow"/>
                        <TextBox Classes="mono" FontSize="12.5" Watermark="Their Monero address (or subaddress)" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="Contacts.Address" AutomationProperties.Name="Contact address" Text="{Binding ContactAddress}"/>
                    </StackPanel>
                    <TextBlock Classes="caption" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="Contacts.Notice"
                               Text="{Binding ContactNotice}" IsVisible="{Binding ContactNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" AutomationProperties.AutomationId="Contacts.Save" AutomationProperties.Name="Save contact" Command="{Binding SaveContactCommand}">
                            <TextBlock Text="Save contact" Foreground="{StaticResource AccentText}"/>
                        </Button>
                        <Button Content="Cancel" AutomationProperties.AutomationId="Contacts.Cancel" Command="{Binding CancelContactCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="14,14,14,12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" Margin="10,2,4,4">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="CONTACTS" Classes="eyebrow"/>
                            <TextBlock Classes="caption" Text="Shared by every wallet this password opens, and sealed in the vault with them."/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" AutomationProperties.AutomationId="Contacts.New" AutomationProperties.Name="New contact"
                                Command="{Binding NewContactCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconPlus}" Width="16" Height="16"/>
                                <TextBlock Text="New contact" Foreground="{StaticResource AccentText}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ItemsControl AutomationProperties.AutomationId="Contacts.List" AutomationProperties.Name="Contacts" ItemsSource="{Binding Profile.Contacts}"
                                  IsVisible="{Binding Profile.HasContacts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactRow">
                                <Border Classes="txRow">
                                    <Grid ColumnDefinitions="Auto,14,*,12,Auto">
                                        <Border Grid.Column="0" Classes="avatar">
                                            <c:Icon Data="{StaticResource IconContacts}" Width="17" Height="17" Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding ShortAddress}" Classes="caption mono"/>
                                            <TextBlock Text="{Binding Note}" Classes="caption" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasNote}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <Button Classes="ghost" AutomationProperties.AutomationId="Contacts.Pay" AutomationProperties.Name="Pay"
                                                    ToolTip.Tip="Pay this contact from the wallet on screen"
                                                    Command="{Binding $parent[w:ContactsTab].((vm:WalletViewModel)DataContext).PayContactRowCommand}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding $parent[w:ContactsTab].((vm:WalletViewModel)DataContext).CanSpend}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <c:Icon Data="{StaticResource IconSend}" Width="15" Height="15"/>
                                                    <TextBlock Text="Pay"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost icon" AutomationProperties.AutomationId="Contacts.Copy" AutomationProperties.Name="Copy address"
                                                    ToolTip.Tip="Copy the address"
                                                    Command="{Binding $parent[w:ContactsTab].((vm:WalletViewModel)DataContext).CopyContactAddressCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource IconCopy}" Width="16" Height="16"/>
                                            </Button>
                                            <Button Classes="ghost icon" AutomationProperties.AutomationId="Contacts.Edit" AutomationProperties.Name="Edit contact"
                                                    ToolTip.Tip="Edit"
                                                    Command="{Binding $parent[w:ContactsTab].((vm:WalletViewModel)DataContext).EditContactCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource IconEdit}" Width="16" Height="16"/>
                                            </Button>
                                            <Button Classes="ghost icon" AutomationProperties.AutomationId="Contacts.Delete" AutomationProperties.Name="Delete contact"
                                                    ToolTip.Tip="Delete"
                                                    Command="{Binding $parent[w:ContactsTab].((vm:WalletViewModel)DataContext).DeleteContactCommand}" CommandParameter="{Binding}">
                                                <c:Icon Data="{StaticResource IconTrash}" Width="16" Height="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel AutomationProperties.AutomationId="Contacts.Empty" IsVisible="{Binding !Profile.HasContacts}" HorizontalAlignment="Center" Spacing="10" Margin="0,26">
                        <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource SurfaceAlt}" HorizontalAlignment="Center">
                            <c:Icon Data="{StaticResource IconContacts}" Width="22" Height="22" Foreground="{StaticResource TextTertiary}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No contacts yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                                   Text="Save the addresses you pay often: Send then shows who you're paying, and History who you paid."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
