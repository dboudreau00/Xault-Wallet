<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
             xmlns:app="clr-namespace:XaultWallet.Desktop"
             xmlns:conv="clr-namespace:XaultWallet.Desktop"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="714"
             x:Class="XaultWallet.Desktop.Views.WalletView"
             x:DataType="vm:WalletViewModel">

    <UserControl.Styles>
        <!-- History row hover -->
        <Style Selector="Border.txRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.txRow:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        </Style>
        <Style Selector="Border.txIcon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="28,20,28,22" RowDefinitions="Auto,Auto,*">

        <!-- ================= Balance + node sync ================= -->
        <Border Grid.Row="0" Classes="card" app:Entrance.Rise="0" Padding="26,22,26,20">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="TOTAL BALANCE" Classes="eyebrow" VerticalAlignment="Center"/>
                            <!-- Network badge: a real-funds mainnet wallet must never be mistaken for a test one -->
                            <Border Classes="pill info" AutomationProperties.AutomationId="Wallet.NetworkBadge" IsVisible="{Binding !IsMainnetWallet}">
                                <TextBlock Text="{Binding NetworkLabel}"/>
                            </Border>
                            <Border Classes="pill danger" AutomationProperties.AutomationId="Wallet.MainnetBadge" IsVisible="{Binding IsMainnetWallet}">
                                <TextBlock Text="MAINNET · REAL FUNDS"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- NamedTextBlock: a plain TextBlock made of Runs has no accessible name in Avalonia 11.1 -->
                            <c:NamedTextBlock x:Name="BalanceText" AutomationProperties.AutomationId="Wallet.Balance" AutomationProperties.Name="{Binding BalanceDisplay}" Classes="mono" FontSize="40" FontWeight="SemiBold" VerticalAlignment="Bottom">
                                <Run Text="{Binding BalanceWhole}"/><Run Text="{Binding BalanceFraction}" Foreground="{StaticResource TextSecondary}"/>
                            </c:NamedTextBlock>
                            <TextBlock Text="XMR" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                       Margin="0,0,0,9" Foreground="{StaticResource TextTertiary}"/>
                            <Button Classes="ghost icon" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                    AutomationProperties.AutomationId="Wallet.HideBalances" AutomationProperties.Name="Hide or show amounts" Command="{Binding ToggleBalancesCommand}" ToolTip.Tip="Hide or show amounts">
                                <Panel>
                                    <c:Icon Data="{StaticResource IconEye}" IsVisible="{Binding !HideBalances}"/>
                                    <c:Icon Data="{StaticResource IconEyeOff}" IsVisible="{Binding HideBalances}"/>
                                </Panel>
                            </Button>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Border Classes="pill success" Margin="0,0,8,0">
                                <TextBlock AutomationProperties.AutomationId="Wallet.Spendable" Text="{Binding UnlockedDisplay}"/>
                            </Border>
                            <Border Classes="pill warning" IsVisible="{Binding HasLocked}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <c:Icon Data="{StaticResource IconClock}" Width="12" Height="12" StrokeThickness="2.2"
                                            Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock AutomationProperties.AutomationId="Wallet.Maturing" Text="{Binding LockedDisplay}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Classes="icon" AutomationProperties.AutomationId="Wallet.Refresh" AutomationProperties.Name="Refresh now" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsReady}"
                                ToolTip.Tip="Refresh now">
                            <c:Icon Data="{StaticResource IconRefresh}" Classes.spin="{Binding RefreshCommand.IsRunning}"/>
                        </Button>
                        <Button Classes="accent" AutomationProperties.AutomationId="Wallet.Lock" AutomationProperties.Name="Lock" Command="{Binding LockCommand}" ToolTip.Tip="Lock the wallet and shred its temporary files">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconLock}" Width="16" Height="16"/>
                                <TextBlock Text="Lock" Foreground="{StaticResource AccentText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Node sync tracker -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"
                                 Classes.pulse="{Binding !IsSynced}"
                                 Fill="{Binding IsSynced, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                        <TextBlock Grid.Column="1" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" AutomationProperties.AutomationId="Wallet.SyncText" Text="{Binding SyncText}"/>
                        <TextBlock Grid.Column="2" Classes="eyebrow" VerticalAlignment="Center" Text="NODE SYNC"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SyncProgress}" Classes.synced="{Binding IsSynced}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Notices: startup failure, format upgrade ================= -->
        <StackPanel Grid.Row="1" app:Entrance.Rise="70">
            <Border IsVisible="{Binding HasUpgradeNotice}" Margin="0,14,0,0" Classes="callout">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconShield}" Foreground="{StaticResource InfoBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding UpgradeNotice}"/>
                    <Button Grid.Column="2" Content="Dismiss" AutomationProperties.AutomationId="Wallet.DismissUpgrade" Command="{Binding DismissUpgradeNoticeCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border AutomationProperties.AutomationId="Wallet.StartupFailed" IsVisible="{Binding StartupFailed}" Margin="0,14,0,0" Classes="callout danger">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconWarning}" Foreground="{StaticResource DangerBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#F3C2C2" Margin="0,0,12,0"
                               AutomationProperties.AutomationId="Wallet.StartupError" Text="{Binding Status}"/>
                    <Button Grid.Column="2" Content="Open Settings" Command="{Binding OpenSettingsCommand}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="Retry" Classes="accent" AutomationProperties.AutomationId="Wallet.Retry" Command="{Binding RetryStartupCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ================= Navigation + panels ================= -->
        <TabControl x:Name="Tabs" AutomationProperties.AutomationId="Wallet.Tabs" Grid.Row="2" Classes="segmented" app:Entrance.Rise="140" Margin="0,18,0,0" Padding="0" IsEnabled="{Binding IsReady}">

            <!-- ==== Receive ==== -->
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.Receive" AutomationProperties.Name="Receive">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconReceive}" Width="16" Height="16"/>
                        <TextBlock Text="Receive" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0">
                    <Border Classes="card" Padding="24">
                        <Grid ColumnDefinitions="Auto,28,*">
                            <Border Grid.Column="0" Width="208" Height="208" CornerRadius="14" ClipToBounds="True"
                                    Background="White" VerticalAlignment="Top">
                                <c:QrCodeView AutomationProperties.AutomationId="Receive.Qr" AutomationProperties.Name="Receive QR code" x:Name="ReceiveQr" Text="{Binding ReceiveUri}" Width="208" Height="208"/>
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="YOUR ADDRESS" Classes="eyebrow"/>
                                <SelectableTextBlock Classes="mono" FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                                     AutomationProperties.AutomationId="Receive.Address" Text="{Binding PrimaryAddress}" Foreground="{StaticResource TextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Classes="accent" AutomationProperties.AutomationId="Receive.Copy" AutomationProperties.Name="Copy address" Click="CopyAddress_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:Icon Data="{StaticResource IconCopy}" Width="16" Height="16"/>
                                            <TextBlock Text="Copy address" Foreground="{StaticResource AccentText}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button AutomationProperties.AutomationId="Receive.NewSubaddress" AutomationProperties.Name="New subaddress" Command="{Binding NewAddressCommand}"
                                            ToolTip.Tip="A fresh, unlinkable address for the same wallet">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:Icon Data="{StaticResource IconPlus}" Width="16" Height="16"/>
                                            <TextBlock Text="New subaddress"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="Receive.Error" Text="{Binding ReceiveNotice}" Classes="caption" TextWrapping="Wrap"
                                           Foreground="{StaticResource WarningBrush}"
                                           IsVisible="{Binding ReceiveNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                           Text="Scan or share this address to receive XMR. Use a new subaddress for each person who pays you — they all reach the same wallet, but can't be linked to each other."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ==== Send ==== -->
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.Send" AutomationProperties.Name="Send">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconSend}" Width="16" Height="16"/>
                        <TextBlock Text="Send" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,14,0,0">
                    <StackPanel Spacing="14">
                        <Border Classes="card" Padding="24,22">
                            <StackPanel Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="DESTINATION ADDRESS" Classes="eyebrow"/>
                                    <TextBox Classes="mono" FontSize="13" AutomationProperties.AutomationId="Send.Address" AutomationProperties.Name="Destination address" Watermark="Paste the recipient's Monero address"
                                             Text="{Binding SendAddress}"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,12,Auto,12,Auto">
                                    <StackPanel Grid.Column="0" Spacing="7">
                                        <TextBlock Text="AMOUNT" Classes="eyebrow"/>
                                        <TextBox Classes="mono" FontSize="15" Watermark="0.00" AutomationProperties.AutomationId="Send.Amount" AutomationProperties.Name="Amount" Text="{Binding SendAmountText}"
                                                 VerticalContentAlignment="Center">
                                            <TextBox.InnerRightContent>
                                                <TextBlock Text="XMR" Classes="eyebrow" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </TextBox.InnerRightContent>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="7">
                                        <TextBlock Text="PRIORITY" Classes="eyebrow"/>
                                        <ComboBox AutomationProperties.AutomationId="Send.Priority" AutomationProperties.Name="Priority" SelectedIndex="{Binding SendPriority}" MinWidth="140">
                                            <ComboBoxItem>Default</ComboBoxItem>
                                            <ComboBoxItem>Low</ComboBoxItem>
                                            <ComboBoxItem>Medium</ComboBoxItem>
                                            <ComboBoxItem>High</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="7" VerticalAlignment="Bottom">
                                        <Button Content="Send max" AutomationProperties.AutomationId="Send.Max" Command="{Binding ReviewSendMaxCommand}" MinHeight="40"
                                                IsEnabled="{Binding !Sending}"
                                                ToolTip.Tip="Sweep the entire spendable balance to this address. The exact amount and fee are shown for confirmation before anything is sent."/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="mono" FontSize="12" AutomationProperties.AutomationId="Send.AmountPreview" Text="{Binding SendAmountPreview}" TextWrapping="Wrap" Margin="0,-8,0,0"
                                           IsVisible="{Binding SendAmountPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{Binding SendAmountPreviewIsError, Converter={x:Static conv:BoolToBrushConverter.ErrorMuted}}"/>
                                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44"
                                        AutomationProperties.AutomationId="Send.Review" AutomationProperties.Name="Review and send" Command="{Binding ReviewSendCommand}" IsEnabled="{Binding !Sending}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <c:Icon Data="{StaticResource IconSend}" Width="16" Height="16"/>
                                        <TextBlock Text="Review &amp; send" Foreground="{StaticResource AccentText}"/>
                                    </StackPanel>
                                </Button>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Sending}" Height="3"/>
                                <TextBlock Classes="muted" TextWrapping="Wrap"
                                           Text="The transaction is built and signed first — you see the exact fee and total before anything is broadcast."/>
                                <!-- Outcome of the last attempt: sent / check History first / not sent -->
                                <Border x:Name="SendOutcomeCard" Classes="callout outcome"
                                        Classes.success="{Binding SendSucceeded}" Classes.warning="{Binding SendNeedsCheck}" Classes.danger="{Binding SendFailed}"
                                        IsVisible="{Binding SendResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Classes="outcomeBadge" VerticalAlignment="Top" Margin="0,0,13,0">
                                            <Panel>
                                                <c:Icon Data="{StaticResource IconCheck}" StrokeThickness="2.4" Width="17" Height="17" IsVisible="{Binding SendSucceeded}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <c:Icon Data="{StaticResource IconWarning}" Width="17" Height="17" IsVisible="{Binding !SendSucceeded}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock AutomationProperties.AutomationId="Send.Result" Classes="outcomeTitle" Text="{Binding SendResult}"/>
                                            <TextBlock AutomationProperties.AutomationId="Send.ResultDetail" Classes="outcomeDetail" Text="{Binding SendResultDetail}"
                                                       IsVisible="{Binding SendResultDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Payment proof from the last send -->
                                <Border Classes="inset" Padding="16" IsVisible="{Binding HasLastTx}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <c:Icon Data="{StaticResource IconShield}" Width="16" Height="16" Foreground="{StaticResource SuccessBrush}"/>
                                            <TextBlock Text="PAYMENT PROOF · LAST SEND" Classes="eyebrow" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="Share the transaction ID and key to prove this payment. The key proves this one payment only — it cannot spend anything. Never share your seed."/>
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,8,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tx ID" Classes="caption" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="mono" FontSize="12" AutomationProperties.AutomationId="Send.LastTxId" Text="{Binding LastTxId}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Row="0" Grid.Column="2" Classes="ghost icon" AutomationProperties.AutomationId="Send.CopyTxId" AutomationProperties.Name="Copy transaction ID" Click="CopyLastTxId_Click" ToolTip.Tip="Copy transaction ID">
                                                <c:Icon Data="{StaticResource IconCopy}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tx key" Classes="caption" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="mono" FontSize="12" AutomationProperties.AutomationId="Send.LastTxKey" Text="{Binding LastTxKey}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Row="2" Grid.Column="2" Classes="ghost icon" AutomationProperties.AutomationId="Send.CopyTxKey" AutomationProperties.Name="Copy transaction key" Click="CopyLastTxKey_Click" ToolTip.Tip="Copy transaction key">
                                                <c:Icon Data="{StaticResource IconCopy}" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Verify any payment -->
                        <Expander AutomationProperties.AutomationId="Proof.Expander" AutomationProperties.Name="Verify a payment" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <c:Icon Data="{StaticResource IconShield}" Width="16" Height="16"/>
                                    <TextBlock Text="Verify a payment" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="check a txid + tx key against an address" Classes="caption" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="10" MaxWidth="680" HorizontalAlignment="Left" Margin="4,6,4,4">
                                <TextBox Classes="mono" FontSize="12" Watermark="Transaction ID" AutomationProperties.AutomationId="Proof.TxId" AutomationProperties.Name="Transaction ID" Text="{Binding VerifyTxId}"/>
                                <TextBox Classes="mono" FontSize="12" Watermark="Transaction key" AutomationProperties.AutomationId="Proof.TxKey" AutomationProperties.Name="Transaction key" Text="{Binding VerifyTxKey}"/>
                                <TextBox Classes="mono" FontSize="12" Watermark="Destination address" AutomationProperties.AutomationId="Proof.Address" AutomationProperties.Name="Destination address" Text="{Binding VerifyAddress}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Verify" Classes="accent" AutomationProperties.AutomationId="Proof.Verify" Command="{Binding VerifyPaymentCommand}"/>
                                    <Button Content="Use last send" AutomationProperties.AutomationId="Proof.UseLast" Command="{Binding PrefillVerifyFromLastCommand}" IsVisible="{Binding HasLastTx}"/>
                                    <Button Content="Fetch key from wallet" AutomationProperties.AutomationId="Proof.FetchKey" Command="{Binding FetchTxKeyCommand}"
                                            ToolTip.Tip="Look up the tx key for a transaction this wallet sent"/>
                                </StackPanel>
                                <TextBlock AutomationProperties.AutomationId="Proof.Result" Text="{Binding VerifyResult}" TextWrapping="Wrap" FontSize="12.5"
                                           IsVisible="{Binding VerifyResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{Binding VerifyOk, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ==== History ==== -->
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.History" AutomationProperties.Name="History">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconHistory}" Width="16" Height="16"/>
                        <TextBlock Text="History" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Classes="card" Margin="0,14,0,0" Padding="12,10,12,12">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,6,4,8">
                            <TextBlock Grid.Column="0" Text="TRANSACTIONS" Classes="eyebrow" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="ghost" AutomationProperties.AutomationId="History.Export" AutomationProperties.Name="Export CSV" Click="ExportHistory_Click" ToolTip.Tip="Save the transaction list as CSV">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <c:Icon Data="{StaticResource IconDownload}" Width="16" Height="16"/>
                                    <TextBlock Text="Export CSV"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasHistory}">
                            <ItemsControl AutomationProperties.AutomationId="History.List" AutomationProperties.Name="Transactions" ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryRow">
                                        <Border Classes="txRow">
                                            <Grid ColumnDefinitions="Auto,14,*,16,Auto,8,Auto">
                                                <!-- direction badge -->
                                                <Border Grid.Column="0" Classes="txIcon" Background="{StaticResource SuccessSoft}" IsVisible="{Binding IsIncoming}">
                                                    <c:Icon Data="{StaticResource IconArrowDown}" Foreground="{StaticResource SuccessBrush}" Width="17" Height="17"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="0" Classes="txIcon" Background="{StaticResource AccentSoft}" IsVisible="{Binding IsOutgoing}">
                                                    <c:Icon Data="{StaticResource IconArrowUp}" Foreground="{StaticResource AccentBrush}" Width="17" Height="17"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="0" Classes="txIcon" Background="{StaticResource DangerSoft}" IsVisible="{Binding IsFailed}">
                                                    <c:Icon Data="{StaticResource IconWarning}" Foreground="{StaticResource DangerBrush}" Width="17" Height="17"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                        <Border Classes="pill warning" IsVisible="{Binding IsPending}" Padding="7,1">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <c:Icon Data="{StaticResource IconClock}" Width="11" Height="11" StrokeThickness="2.2"
                                                                        Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="pending" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle}" Classes="caption"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding AmountText}" Classes="mono" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" IsVisible="{Binding IsIncoming}"
                                                               Foreground="{StaticResource SuccessBrush}"/>
                                                    <TextBlock Text="{Binding AmountText}" Classes="mono" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" IsVisible="{Binding !IsIncoming}"/>
                                                    <TextBlock HorizontalAlignment="Right" Classes="caption mono" Text="{Binding DetailText}"/>
                                                </StackPanel>

                                                <Button Grid.Column="6" Classes="ghost icon" VerticalAlignment="Center"
                                                        AutomationProperties.AutomationId="History.CopyTxId" AutomationProperties.Name="Copy transaction ID" Click="CopyRowTxId_Click" ToolTip.Tip="Copy transaction ID">
                                                    <c:Icon Data="{StaticResource IconCopy}" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" AutomationProperties.AutomationId="History.Empty" IsVisible="{Binding !HasHistory}" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Spacing="10" Margin="0,30">
                            <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource SurfaceAlt}" HorizontalAlignment="Center">
                                <c:Icon Data="{StaticResource IconHistory}" Width="22" Height="22" Foreground="{StaticResource TextTertiary}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No transactions yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                                       Text="Payments in and out appear here once the wallet has scanned the blocks they're in."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ===== Auto-lock countdown: the wallet never just vanishes mid-read ===== -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding LockImminent}" VerticalAlignment="Bottom"
                Classes="callout warning" Margin="0,0,0,2" Background="#F21E1A12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Grid.Column="0" Data="{StaticResource IconLock}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#F1E2B6" Text="{Binding LockCountdownText}"/>
                <Button Grid.Column="2" Content="Stay unlocked" Classes="accent" AutomationProperties.AutomationId="Wallet.StayUnlocked" Command="{Binding StayUnlockedCommand}"/>
            </Grid>
        </Border>

        <!-- ===== Send confirmation (Monero is irreversible; always confirm) ===== -->
        <Border x:Name="ConfirmScrim" Grid.Row="0" Grid.RowSpan="3" Margin="-28,-20,-28,-22" AutomationProperties.AutomationId="SendConfirm" IsVisible="{Binding ShowSendConfirm}" Background="{StaticResource Scrim}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border x:Name="ConfirmSheet" Classes="card" Width="500" Padding="28,26" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoft}">
                            <c:Icon Data="{StaticResource IconSend}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Confirm this send" Classes="h2"/>
                            <TextBlock AutomationProperties.AutomationId="SendConfirm.Summary" Text="{Binding SendSummary}" Classes="caption"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bound to the SNAPSHOT the prepared tx pays, never the live form field. -->
                    <Border Classes="inset" Padding="14,12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="RECIPIENT" Classes="eyebrow"/>
                            <SelectableTextBlock Classes="mono" FontSize="12.5" LineHeight="19" AutomationProperties.AutomationId="SendConfirm.Recipient" Text="{Binding ConfirmSendAddress}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Exact cost: the tx is already built (unbroadcast); this fee cannot change. -->
                    <Border Classes="inset" Padding="16,14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Amount" Classes="muted"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13" HorizontalAlignment="Right" AutomationProperties.AutomationId="SendConfirm.Amount" Text="{Binding ConfirmAmountText}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Network fee" Classes="muted"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13" HorizontalAlignment="Right" AutomationProperties.AutomationId="SendConfirm.Fee" Text="{Binding SendFeeText}"/>
                            </Grid>
                            <Rectangle Fill="{StaticResource BorderSubtle}" Height="1"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Total" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" AutomationProperties.AutomationId="SendConfirm.Total" Text="{Binding SendTotalText}"/>
                            </Grid>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="The fee is locked into the signed transaction — it can't change after you confirm."/>
                        </StackPanel>
                    </Border>

                    <Border Classes="callout danger" IsVisible="{Binding SendFeeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Foreground="#F3C2C2" AutomationProperties.AutomationId="SendConfirm.FeeWarning" Text="{Binding SendFeeWarning}"/>
                    </Border>

                    <Border Classes="callout warning">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:Icon Grid.Column="0" Data="{StaticResource IconWarning}" Foreground="{StaticResource WarningBrush}"
                                    Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Foreground="#EBD9AE"
                                       Text="Monero transactions are irreversible. Check the address — funds sent to a wrong address can't be recovered."/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="42" AutomationProperties.AutomationId="SendConfirm.Cancel" Command="{Binding CancelSendCommand}"/>
                        <Button Grid.Column="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="42" AutomationProperties.AutomationId="SendConfirm.Send" AutomationProperties.Name="Send now" Command="{Binding ConfirmSendCommand}">
                            <TextBlock Text="Send now" Foreground="{StaticResource AccentText}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
          </ScrollViewer>
        </Border>

        <!-- ===== Toast: copy / export feedback, on whichever tab is open ===== -->
        <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="3" Classes="toast" IsVisible="False" IsHitTestVisible="False"
                AutomationProperties.AutomationId="Wallet.Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <c:Icon x:Name="ToastOk" Data="{StaticResource IconCheck}" Width="15" Height="15" StrokeThickness="2.4"
                        Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <c:Icon x:Name="ToastProblem" Data="{StaticResource IconWarning}" Width="15" Height="15"
                        Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" IsVisible="False"/>
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="12.5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
