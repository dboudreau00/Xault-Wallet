<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XaultWallet.Desktop.ViewModels"
             xmlns:app="clr-namespace:XaultWallet.Desktop"
             xmlns:conv="clr-namespace:XaultWallet.Desktop"
             xmlns:c="clr-namespace:XaultWallet.Desktop.Controls"
             xmlns:w="clr-namespace:XaultWallet.Desktop.Views.Wallet"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="714"
             x:Class="XaultWallet.Desktop.Views.WalletView"
             x:DataType="vm:WalletViewModel">

    <UserControl.Styles>
        <!-- List rows (history, addresses, contacts): a quiet hover, no chrome -->
        <Style Selector="Border.txRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.txRow:pointerover">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        </Style>
        <Style Selector="Border.txRow.open">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        </Style>
        <Style Selector="Border.txIcon">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- A whole row as one button (history): the content lays out like a plain row -->
        <Style Selector="Button.rowButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Button.rowButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Window.motion Button.rowButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.995)"/>
        </Style>

        <!-- Small filter chips (history) -->
        <Style Selector="RadioButton.chip">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Chip" Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,6"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                        <ContentPresenter Content="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton.chip:pointerover">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="RadioButton.chip:checked">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- The wallet switcher reads as a title, not a form field -->
        <Style Selector="ComboBox.switcher">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style Selector="ComboBox.switcher:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
        </Style>

        <!-- Initial-letter avatar (contacts) -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
        </Style>
        <Style Selector="Border.avatar > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Section header inside a tab card -->
        <Style Selector="StackPanel.toolHeader">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="10"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="28,14,28,22" RowDefinitions="Auto,Auto,*">

        <!-- ================= Wallet bar, balance, node sync ================= -->
        <Border Grid.Row="0" Classes="card" app:Entrance.Rise="0" Padding="20,12,22,18">
            <StackPanel Spacing="12">
                <!-- Which wallet (switcher), add, manage · network · refresh, lock -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <ComboBox Grid.Column="0" Classes="switcher" x:Name="Switcher" MinWidth="200" MaxWidth="360"
                              AutomationProperties.AutomationId="Wallet.Switcher" AutomationProperties.Name="Wallet"
                              ToolTip.Tip="Switch wallet"
                              ItemsSource="{Binding Profile.Wallets}" SelectedItem="{Binding Profile.SelectedWallet}">
                        <ComboBox.Styles>
                            <!-- Each item is announced (and found by UI Automation) by the wallet's name -->
                            <Style Selector="ComboBoxItem" x:DataType="vm:WalletChoice">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WalletChoice">
                                <StackPanel Orientation="Horizontal" Spacing="11">
                                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                        <c:Icon Data="{StaticResource IconWallet}" Width="16" Height="16" Foreground="{StaticResource AccentBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Classes="caption"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Classes="ghost icon" AutomationProperties.AutomationId="Wallet.Add" AutomationProperties.Name="Add a wallet"
                                Command="{Binding Profile.AddWalletCommand}" ToolTip.Tip="Add a wallet to this vault: new, restored, or watch-only">
                            <c:Icon Data="{StaticResource IconPlus}"/>
                        </Button>
                        <Button Classes="ghost" AutomationProperties.AutomationId="Wallet.Manage" AutomationProperties.Name="Manage wallet"
                                Command="{Binding OpenManageCommand}" ToolTip.Tip="Name, node, accounts, backup (seed and keys), remove">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <c:Icon Data="{StaticResource IconSettings}" Width="16" Height="16"/>
                                <TextBlock Text="Manage"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Network badge: a real-funds mainnet wallet must never be mistaken for a test one -->
                        <Border Classes="pill info" VerticalAlignment="Center" AutomationProperties.AutomationId="Wallet.NetworkBadge" IsVisible="{Binding !IsMainnetWallet}">
                            <TextBlock Text="{Binding NetworkLabel}"/>
                        </Border>
                        <Border Classes="pill danger" VerticalAlignment="Center" AutomationProperties.AutomationId="Wallet.MainnetBadge" IsVisible="{Binding IsMainnetWallet}">
                            <TextBlock Text="MAINNET · REAL FUNDS"/>
                        </Border>
                        <Border Classes="pill warning" VerticalAlignment="Center" AutomationProperties.AutomationId="Wallet.WatchOnlyBadge" IsVisible="{Binding IsViewOnly}"
                                ToolTip.Tip="This wallet has the view key only: it sees incoming payments but can't spend">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <c:Icon Data="{StaticResource IconEye}" Width="12" Height="12" StrokeThickness="2.2" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="WATCH-ONLY"/>
                            </StackPanel>
                        </Border>
                        <Button Classes="icon" AutomationProperties.AutomationId="Wallet.Refresh" AutomationProperties.Name="Refresh now" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsReady}"
                                ToolTip.Tip="Refresh now">
                            <c:Icon Data="{StaticResource IconRefresh}" Classes.spin="{Binding RefreshCommand.IsRunning}"/>
                        </Button>
                        <Button Classes="accent" AutomationProperties.AutomationId="Wallet.Lock" AutomationProperties.Name="Lock" Command="{Binding LockCommand}"
                                ToolTip.Tip="Lock the vault: every wallet stops and its temporary files are shredded">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <c:Icon Data="{StaticResource IconLock}" Width="16" Height="16"/>
                                <TextBlock Text="Lock" Foreground="{StaticResource AccentText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding BalanceLabel}" Classes="eyebrow" VerticalAlignment="Center"/>
                        <!-- Accounts: separate balances inside one wallet (shown once there are several) -->
                        <ComboBox AutomationProperties.AutomationId="Wallet.Account" AutomationProperties.Name="Account"
                                  IsVisible="{Binding HasSeveralAccounts}" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                  MinHeight="30" Padding="10,3" FontSize="12.5" VerticalAlignment="Center" ToolTip.Tip="Account">
                            <ComboBox.Styles>
                                <Style Selector="ComboBoxItem" x:DataType="vm:AccountChoice">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                </Style>
                            </ComboBox.Styles>
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccountChoice">
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- NamedTextBlock: a plain TextBlock made of Runs has no accessible name in Avalonia 11.1 -->
                        <c:NamedTextBlock x:Name="BalanceText" AutomationProperties.AutomationId="Wallet.Balance" AutomationProperties.Name="{Binding BalanceDisplay}" Classes="mono" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Bottom">
                            <Run Text="{Binding BalanceWhole}"/><Run Text="{Binding BalanceFraction}" Foreground="{StaticResource TextSecondary}"/>
                        </c:NamedTextBlock>
                        <TextBlock Text="XMR" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8" Foreground="{StaticResource TextTertiary}"/>
                        <Button Classes="ghost icon" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                AutomationProperties.AutomationId="Wallet.HideBalances" AutomationProperties.Name="Hide or show amounts" Command="{Binding ToggleBalancesCommand}" ToolTip.Tip="Hide or show amounts">
                            <Panel>
                                <c:Icon Data="{StaticResource IconEye}" IsVisible="{Binding !HideBalances}"/>
                                <c:Icon Data="{StaticResource IconEyeOff}" IsVisible="{Binding HideBalances}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Border Classes="pill success" Margin="0,0,8,0">
                            <TextBlock AutomationProperties.AutomationId="Wallet.Spendable" Text="{Binding UnlockedDisplay}"/>
                        </Border>
                        <Border Classes="pill warning" IsVisible="{Binding HasLocked}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <c:Icon Data="{StaticResource IconClock}" Width="12" Height="12" StrokeThickness="2.2"
                                        Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock AutomationProperties.AutomationId="Wallet.Maturing" Text="{Binding LockedDisplay}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Node sync tracker -->
                <StackPanel Spacing="8" Margin="6,0,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"
                                 Classes.pulse="{Binding !IsSynced}"
                                 Fill="{Binding IsSynced, Converter={x:Static conv:BoolToBrushConverter.OkWarn}}"/>
                        <TextBlock Grid.Column="1" Classes="mono" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" AutomationProperties.AutomationId="Wallet.SyncText" Text="{Binding SyncText}"/>
                        <TextBlock Grid.Column="2" Classes="eyebrow" VerticalAlignment="Center" Text="NODE SYNC"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SyncProgress}" Classes.synced="{Binding IsSynced}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Notices: startup failure, format upgrade ================= -->
        <StackPanel Grid.Row="1" app:Entrance.Rise="70">
            <Border IsVisible="{Binding Profile.HasUpgradeNotice}" Margin="0,14,0,0" Classes="callout">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconShield}" Foreground="{StaticResource InfoBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Profile.UpgradeNotice}"/>
                    <Button Grid.Column="2" Content="Dismiss" AutomationProperties.AutomationId="Wallet.DismissUpgrade" Command="{Binding Profile.DismissUpgradeNoticeCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <Border AutomationProperties.AutomationId="Wallet.StartupFailed" IsVisible="{Binding StartupFailed}" Margin="0,14,0,0" Classes="callout danger">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <c:Icon Grid.Column="0" Data="{StaticResource IconWarning}" Foreground="{StaticResource DangerBrush}"
                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#F3C2C2" Margin="0,0,12,0"
                               AutomationProperties.AutomationId="Wallet.StartupError" Text="{Binding Status}"/>
                    <Button Grid.Column="2" Content="Open Settings" Command="{Binding OpenSettingsCommand}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Content="Retry" Classes="accent" AutomationProperties.AutomationId="Wallet.Retry" Command="{Binding RetryStartupCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ================= Navigation + panels ================= -->
        <TabControl x:Name="Tabs" AutomationProperties.AutomationId="Wallet.Tabs" Grid.Row="2" Classes="segmented" app:Entrance.Rise="140"
                    Margin="0,16,0,0" Padding="0" IsEnabled="{Binding IsReady}" SelectedIndex="{Binding SelectedTab}">
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.Receive" AutomationProperties.Name="Receive">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconReceive}" Width="16" Height="16"/>
                        <TextBlock Text="Receive" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <w:ReceiveTab/>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.Send" AutomationProperties.Name="Send">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconSend}" Width="16" Height="16"/>
                        <TextBlock Text="Send" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <w:SendTab/>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.History" AutomationProperties.Name="History">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconHistory}" Width="16" Height="16"/>
                        <TextBlock Text="History" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <w:HistoryTab/>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.Contacts" AutomationProperties.Name="Contacts">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconContacts}" Width="16" Height="16"/>
                        <TextBlock Text="Contacts" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <w:ContactsTab/>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="Wallet.Tab.Tools" AutomationProperties.Name="Tools">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <c:Icon Classes="tabIcon" Data="{StaticResource IconTools}" Width="16" Height="16"/>
                        <TextBlock Text="Tools" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <w:ToolsTab/>
            </TabItem>
        </TabControl>

        <!-- ===== Auto-lock countdown: the wallet never just vanishes mid-read ===== -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding Profile.LockImminent}" VerticalAlignment="Bottom"
                Classes="callout warning" Margin="0,0,0,2" Background="#F21E1A12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <c:Icon Grid.Column="0" Data="{StaticResource IconLock}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#F1E2B6" Text="{Binding Profile.LockCountdownText}"/>
                <Button Grid.Column="2" Content="Stay unlocked" Classes="accent" AutomationProperties.AutomationId="Wallet.StayUnlocked" Command="{Binding Profile.StayUnlockedCommand}"/>
            </Grid>
        </Border>

        <!-- ===== Send confirmation (Monero is irreversible; always confirm) ===== -->
        <Border x:Name="ConfirmScrim" Grid.Row="0" Grid.RowSpan="3" Margin="-28,-14,-28,-22" AutomationProperties.AutomationId="SendConfirm" IsVisible="{Binding ShowSendConfirm}" Background="{StaticResource Scrim}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border x:Name="ConfirmSheet" Classes="card" Width="520" Padding="28,26" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoft}">
                            <c:Icon Data="{StaticResource IconSend}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Confirm this send" Classes="h2"/>
                            <TextBlock AutomationProperties.AutomationId="SendConfirm.Summary" Text="{Binding SendSummary}" Classes="caption"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bound to the SNAPSHOT the prepared tx pays, never the live form fields. -->
                    <Border Classes="inset" Padding="14,12" IsVisible="{Binding !ConfirmHasSeveral}">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="RECIPIENT" Classes="eyebrow"/>
                                <Border Classes="pill info" Padding="7,0" IsVisible="{Binding ConfirmRecipientName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock AutomationProperties.AutomationId="SendConfirm.RecipientName" Text="{Binding ConfirmRecipientName}" FontSize="10.5"/>
                                </Border>
                            </StackPanel>
                            <SelectableTextBlock Classes="mono" FontSize="12.5" LineHeight="19" AutomationProperties.AutomationId="SendConfirm.Recipient" Text="{Binding ConfirmSendAddress}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="inset" Padding="14,12" IsVisible="{Binding ConfirmHasSeveral}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="RECIPIENTS" Classes="eyebrow"/>
                            <ItemsControl AutomationProperties.AutomationId="SendConfirm.Recipients" ItemsSource="{Binding ConfirmLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ConfirmLine">
                                        <Grid ColumnDefinitions="*,12,Auto" Margin="0,3">
                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="13"/>
                                                <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding Address}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="13" Text="{Binding Amount}" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Exact cost: the tx is already built (unbroadcast); this fee cannot change. -->
                    <Border Classes="inset" Padding="16,14">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Amount" Classes="muted"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13" HorizontalAlignment="Right" AutomationProperties.AutomationId="SendConfirm.Amount" Text="{Binding ConfirmAmountText}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Network fee" Classes="muted"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13" HorizontalAlignment="Right" AutomationProperties.AutomationId="SendConfirm.Fee" Text="{Binding SendFeeText}"/>
                            </Grid>
                            <Rectangle Fill="{StaticResource BorderSubtle}" Height="1"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Total" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" AutomationProperties.AutomationId="SendConfirm.Total" Text="{Binding SendTotalText}"/>
                            </Grid>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="The fee is locked into the signed transaction — it can't change after you confirm."/>
                        </StackPanel>
                    </Border>

                    <Border Classes="callout danger" IsVisible="{Binding SendFeeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Foreground="#F3C2C2" AutomationProperties.AutomationId="SendConfirm.FeeWarning" Text="{Binding SendFeeWarning}"/>
                    </Border>

                    <Border Classes="callout warning">
                        <Grid ColumnDefinitions="Auto,*">
                            <c:Icon Grid.Column="0" Data="{StaticResource IconWarning}" Foreground="{StaticResource WarningBrush}"
                                    Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Foreground="#EBD9AE"
                                       Text="Monero transactions are irreversible. Check the address — funds sent to a wrong address can't be recovered."/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,10,*">
                        <Button Grid.Column="0" Content="Cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="42" AutomationProperties.AutomationId="SendConfirm.Cancel" Command="{Binding CancelSendCommand}"/>
                        <Button Grid.Column="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                MinHeight="42" AutomationProperties.AutomationId="SendConfirm.Send" AutomationProperties.Name="Send now" Command="{Binding ConfirmSendCommand}">
                            <TextBlock Text="Send now" Foreground="{StaticResource AccentText}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
          </ScrollViewer>
        </Border>

        <!-- ===== Manage this wallet: name, node, accounts, backup, remove ===== -->
        <Border x:Name="ManageScrim" Grid.Row="0" Grid.RowSpan="3" Margin="-28,-14,-28,-22" AutomationProperties.AutomationId="Manage" IsVisible="{Binding ShowManage}" Background="{StaticResource Scrim}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <w:ManageSheet x:Name="ManageSheet" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ScrollViewer>
        </Border>

        <!-- ===== Toast: copy / export feedback, on whichever tab is open ===== -->
        <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="3" Classes="toast" IsVisible="False" IsHitTestVisible="False"
                AutomationProperties.AutomationId="Wallet.Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <c:Icon x:Name="ToastOk" Data="{StaticResource IconCheck}" Width="15" Height="15" StrokeThickness="2.4"
                        Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                <c:Icon x:Name="ToastProblem" Data="{StaticResource IconWarning}" Width="15" Height="15"
                        Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" IsVisible="False"/>
                <TextBlock x:Name="ToastText" VerticalAlignment="Center" FontSize="12.5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
