<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\xault.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- The release's name: what the tag, the archives and Settings say. A letter after the patch
         number marks a revision of that release (0.6.0a is the first after 0.6.0, 0.6.0b the second). -->
    <ReleaseVersion>0.7.0b-beta</ReleaseVersion>
    <!-- What .NET needs: a SemVer version (the letter joins the pre-release label, so 0.6.0-beta.a
         sorts after 0.6.0-beta) and a numeric file version (a = 1, b = 2). -->
    <Version>0.7.0-beta.b</Version>
    <FileVersion>0.7.0.2</FileVersion>
    <InformationalVersion>$(ReleaseVersion)</InformationalVersion>
    <AssemblyName>XaultWallet</AssemblyName>
    <Product>XaultWallet</Product>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Publish only: one self-contained file that runs with no .NET installed. Plain builds stay
       framework-dependent (fast dotnet run; the project can be referenced by UI tooling). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebuggerSupport>false</DebuggerSupport>
    <!-- DOTNET_STARTUP_HOOKS (which any program can set in the user's environment) is ignored. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- QRCoder 1.8 depends on these two for its bitmap renderers (Windows GDI+), which are never used:
         the app reads the module matrix only (QrCodeView). Their assets stay out of the build, so they
         are not shipped and not in THIRD-PARTY-NOTICES.md. Keep the versions QRCoder asks for. -->
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="6.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XaultWallet.Core\XaultWallet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless UI snapshots + view smoke tests drive the preview constructors. -->
    <InternalsVisibleTo Include="UiSnapshots" />
    <!-- The in-process end-to-end test keeps its profile in a throwaway folder (AppServices.TestProfile). -->
    <InternalsVisibleTo Include="XaultWallet.E2E.Headless" />
  </ItemGroup>

</Project>
